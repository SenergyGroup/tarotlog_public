<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>MyTarotTales</title>

  <!-- Main site stylesheet (if you have an external one, keep this link) -->
  <link rel="stylesheet" href="/styles.css"> 

  <!-- Include a decorative serif font (for headings & buttons) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link 
    href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&display=swap" 
    rel="stylesheet"
  >

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-JYXX0G315R"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-JYXX0G315R');
  </script>
  <script src="/profile.js"></script>

  <!-- Inline styles -->
  <style>
    html, body {
      margin: 0;
      padding: 0;
      min-height: 100%;
      width: 100%;
      font-family: sans-serif;
      box-sizing: border-box;
      background-color: #000;
    }
    .hero-swirls {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      background:
        linear-gradient(to right, rgba(0,0,0,0.3) 0%, rgba(0,0,0,1) 100%),
        url('https://raw.githubusercontent.com/SenergyGroup/tarotlog_assets/refs/heads/main/swirl-bg.jpg')
          center center / cover no-repeat;
    }
    /* Top Nav */
    .top-nav {
      position: absolute;
      top: 1rem;
      right: 1.5rem;
      z-index: 10;
      display: flex;
      align-items: center;
    }
    .desktop-nav ul {
      display: flex;
      gap: 1rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .desktop-nav a {
      display: inline-block;
      font-family: 'Cinzel Decorative', serif;
      font-weight: 400;
      font-size: 0.9rem;
      padding: 0.5rem 1.2rem;
      border-radius: 50px;
      border: 2px solid #fff;
      background: transparent;
      color: #fff;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .desktop-nav a:hover {
      background: #fff;
      color: #000;
    }
    /* Hamburger menu for mobile */
    .hamburger {
      position: absolute; /* Moves it to the top right corner */
      top: 1rem;
      right: 1rem;
      background: none;
      border: none;
      font-size: 2rem;
      color: #fff;
      cursor: pointer;
      display: none; /* hidden on large screens */
      z-index: 11;
    }
    .mobile-menu {
      display: none;
      position: absolute;
      top: 3rem;
      right: 1rem;
      background: #fff;
      border: 2px solid #fff;
      border-radius: 5px;
      flex-direction: column;
      z-index: 10;
    }
    .mobile-menu a {
      display: block;
      padding: 0.5rem 1rem;
      color: #000;
      text-decoration: none;
    }
    .mobile-menu a:hover {
      background: #f0f0f0;
    }
    /* Card Container & Card */
    .card-container {
      position: fixed;
      top: 50%;
      left: 25%;
      transform: translate(-50%, -50%);
      z-index: 5;
      perspective: 1000px;
    }
    .card-wrapper {
      position: relative;
      width: 260px;
      height: 433px; /* Match your card's aspect ratio */
      transform-style: preserve-3d;
      transition: transform 0.8s cubic-bezier(0.4, 0.2, 0.2, 1);
    }
    .tarot-back {
      width: 260px;
      height: auto;
      box-shadow: 0 12px 25px rgba(0,0,0,0.6);
      cursor: pointer;
      backface-visibility: hidden;
    }
    .tarot-front {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      transform: rotateY(180deg);
    }
    .card-wrapper.flipped {
      transform: rotateY(180deg);
    }
    .card-wrapper.flipped.reversed {
      transform: rotateY(180deg) rotateZ(180deg);
    }
    .tarot-back:hover {
      transform: scale(1.01);
    }
    .card-wrapper.flipped:hover {
      transform: rotateY(180deg) scale(1.01);
    }
    /* Hero Text */
    .hero-text {
      position: fixed;
      top: 50%;
      right: 5%;
      transform: translateY(-50%);
      text-align: left;
      max-width: 600px;
      color: #fff;
      z-index: 5;
      transition: opacity 0.5s ease;
      width: 40%;
    }
    .hero-text h1 {
      font-family: 'Cinzel Decorative', serif;
      font-size: 5rem;
      line-height: 1.1;
      margin-bottom: 1rem;
      letter-spacing: 0.6px;
    }
    .hero-text p {
      font-size: 1.25rem;
      line-height: 1.5;
      margin-bottom: 2rem;
    }
    .hero-text.reset-state {
      position: fixed ;
      top: 50% ;
      right: 5% ;
      transform: translateY(-50%) ;
      width: 40% ;
      text-align: left ;
      margin-top: 0 !important;
    }
    /* Typewriter Sytle */
    @keyframes flip {
      0% { transform: rotateY(0deg); }
      100% { transform: rotateY(180deg); }
    }

    @keyframes typewriter {
      from { width: 0; }
      to { width: 100%; }
    }

    .typing-cursor {
      display: inline-block;
      width: 0.1em;
      margin-left: 2px;
      background-color: white;
      animation: blink 1s step-end infinite;
    }

    @keyframes blink {
      from, to { background-color: transparent; }
      50% { background-color: white; }
    }

    #card-prompt {
      white-space: pre-wrap;
      overflow: hidden;
      position: relative;
    }
    /* CTA Buttons */
    .cta-buttons {
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }
    .btn {
      font-family: 'Cinzel Decorative', serif;
      font-size: 1rem;
      font-weight: 400;
      padding: 0.8rem 1.5rem;
      border-radius: 50px;
      border: 2px solid #fff;
      background: transparent;
      color: #fff;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .btn:hover {
      background: #fff;
      color: #000;
      transform: translateY(-2px);
    }
    .draw-btn {
      background: #8b5cf6; 
      border-color: #8b5cf6;
    }
    .draw-btn:hover {
      background: #fff;
      color: #000;
    }
    .save-response-btn {
      margin-top: 1rem;
      position: relative;
      right: 5%;
    }
    .response-box {
      width: 90%;
      margin-right: 0;
    }
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
    }
    
    .modal-box {
      background: linear-gradient(145deg, var(--muted), var(--background));
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 1rem;
      padding: 2rem;
      width: 90%;
      max-width: 400px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.7);
      color: var(--foreground);
      text-align: center;
    }
    
    .modal-title {
      font-size: 1.5rem;
      margin-bottom: 1rem;
      color: var(--primary);
    }
        
    .modal-buttons {
        display: flex;
        justify-content: center;
        gap: 1.5rem; /* ↑ increases space between buttons */
        margin-top: 1.5rem;
    }

    .modal-buttons .btn {
        flex: 1;
    }
    
    .hidden {
      display: none !important;
    }
    /* Responsive adjustments for screens below 1000px */
    @media (max-width: 1099px) {
      .desktop-nav {
        display: none;
      }
      .hamburger {
        display: block;
        z-index: 1;
      }
      .hero-swirls {
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .card-container,
      .hero-text{
        position: relative;
      }
      .hero-text {
        right: 0%;
        transition: all 0.5s ease, opacity 0.5s ease !important;
        transform: translateY(0) !important;
        margin-top: 2rem !important;
      }
      .card-container {
        transition: all 0.5s ease;
      }
      /* Initial hidden state for mobile */
      .hero-text.initial-load {
        opacity: 0;
        transform: translateY(20px) !important;
      }
      /* Animated reveal */
      .hero-text.reveal {
        opacity: 1 !important;
        transform: translateY(0) !important;
      }
      .hero-text h1, .hero-text p {
        margin-right: 0;
      }
      .hero-text.reset-state {
        position: relative !important;
        transform: none !important;;
        width: 90% !important;;
        text-align: center !important;;
        margin: 1rem auto 0 !important;;
        top: auto !important;;
        right: auto !important;;
      }
      .hero-text.reset-state p {
        text-align: center !important;
      }
      .card-container {
        top: 0;
        left: 0;
        transform: none;
        margin-bottom: 1rem;
        margin-top: 5rem;
      }
      .hero-text {
        width: 90%;
        margin: 0 auto;
        transform: none;
        text-align: center;
        margin-top: 1rem;
      }
      .cta-buttons {
      display: block;
      gap: 3.5rem;
    }
    }
    /* Existing mobile adjustments for max-width: 768px */
    @media (max-width: 768px) {
      .desktop-nav {
        display: none;
      }
      .content {
        margin-top: 10vh;
      }
      .card-container {
        margin-top: 7rem;
      }
      .hero-text {
        right: 0;
      }
      .hero-text h1 {
        font-size: 2.8rem;
      }
      .hero-text p {
        font-size: 1rem;
        max-width: 90%;
        margin: 1rem auto 2rem;
      }
      .btn {
        font-size: 0.8rem;
      }
      .response-box {
      width: 100%;
    }
    }
  </style>
</head>
<body>
    <nav class="desktop-nav top-nav">
      <ul>
        <li><a href="/auth/login">Sign In</a></li>
        <li><a href="/auth/signup">Sign Up</a></li>
      </ul>
    </nav>
    <button class="hamburger" onclick="toggleMenu()">&#9776;</button>
    <div class="mobile-menu" id="mobileMenu">
      <a href="/auth/login">Sign In</a>
      <a href="/auth/signup">Sign Up</a>
    </div>

  <section class="hero-swirls"> </section>
    <div class="card-container">
      <div class="card-wrapper">
        <img 
          src="https://raw.githubusercontent.com/SenergyGroup/tarotlog_assets/refs/heads/main/deck_backs/tarot-card-default.webp"
          alt="Tarot Card"
          class="tarot-back"
        />
        <img id="drawn-card" class="tarot-front" alt="Card Front" />
      </div>
    </div>
    <div class="hero-text" id="hero-text">
      <h1>Your Card <br> Awaits</h1>
      <p>Draw a card and get a unique journal prompt,
         or start writing and let the card pick you.</p>
        <textarea id="response-1" class="response-box hidden" placeholder="Your answer to the prompt..."></textarea>
