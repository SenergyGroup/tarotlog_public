          Start Writing
        </button>
      </div>
    </div>
    <!-- 1) Modal HTML (initially hidden) -->
    <div id="account-modal-overlay" class="modal-overlay hidden">
      <div id="account-modal-box" class="modal-box">
      <h2>Uh Oh!</h2>
      <p>
          It looks like you are not logged in. Make an account to save your journals.
      </p>
      <div class="modal-buttons">
          <button id="modal-make-account-btn" class="btn write-btn">Make an Account</button>
          <button id="modal-lose-data-btn" class="btn write-btn">Lose My Data</button>
      </div>
      </div>
    </div>

  <!-- Toggle script for mobile hamburger menu -->
  <script>
    function toggleMenu() {
      var menu = document.getElementById('mobileMenu');
      menu.style.display = (menu.style.display === 'block') ? 'none' : 'block';
    }
  </script>
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        console.log("DOMContentLoaded event fired");
        const API_BASE_URL = '';  // Set your API base URL if needed
        const user = window.user || null; // Assumes your user object is defined globally
        let isDrawing = false;
        const heroText = document.getElementById('hero-text');
        const responseBox = document.getElementById('response-1');
        const saveButton = document.getElementById('save-response-btn');
        const drawButton = document.getElementById('draw-btn');
        const writeButton = document.getElementById('write-btn');
        console.log("Hero text element:", heroText);
  
        // Fade out hero text returns a promise so we can wait for it.
        function fadeOutHeroText() {
          return new Promise(resolve => {
            console.log("Fading out hero text");
            heroText.style.opacity = '0';
            drawButton.classList.add('hidden');
            writeButton.classList.add('hidden');

            setTimeout(() => {
              heroText.style.display = 'none';
              console.log("Hero text hidden");
              resolve();
            }, 500);
          });
        }
        // Fade element in
        function fadeIn(element) {
          console.log("Fading in element:", element);
          element.style.display = 'block';
          element.style.opacity = '0';
          void element.offsetHeight;
          element.style.opacity = '1';

          setTimeout(() => {
            element.style.opacity = '1';
            console.log("Element faded in:", element);
          }, 50);
        }
        
        // Set up mood slider functionality (if applicable)
        const moodSlider = document.getElementById("mood-slider");
        const moodDisplay = document.getElementById("mood-display");
        if(moodSlider && moodDisplay){
          const moodMap = { 1: "😞", 2: "😒", 3: "😐", 4: "🙂", 5: "😊" };
          function updateMoodDisplay(value) {
            const moodIcon = moodMap[value] || "😐";
            moodDisplay.textContent = `${moodIcon} (${value})`;
          }
          updateMoodDisplay(moodSlider.value);
          moodSlider.addEventListener("input", () => {
            updateMoodDisplay(moodSlider.value);
            console.log("Mood slider updated:", moodSlider.value);
          });
        }
        
        // Create a spinner element for loading feedback
        const spinner = document.createElement('div');
        spinner.style.cssText = `
          display: none;
          position: fixed; /* Changed from absolute */
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          border: 4px solid rgba(0,0,0,0.1);
          border-top: 4px solid #f3f3f3;
          border-radius: 50%;
          width: 40px;
          height: 40px;
          animation: spin 1s linear infinite;
          z-index: 9999; /* Ensure it's above other elements */
        `;
        document.body.appendChild(spinner);
        console.log("Spinner created");
        
        // Add spinner keyframes
        const style = document.createElement('style');
        style.innerHTML = `
          @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
          }
        `;
        document.head.appendChild(style);
        
        // Prevent drawing more than once if not logged in
        function checkPendingCard() {
          const pending = localStorage.getItem('pendingdrawCard');
          console.log("Checking pending card:", pending);
          if (pending) {
            try {
              const pendingData = JSON.parse(pending);
              const storedDate = new Date(pendingData.timestamp);
              const today = new Date();
              
              // Check if same day
              if(storedDate.getDate() !== today.getDate() || 
                storedDate.getMonth() !== today.getMonth() ||
                storedDate.getFullYear() !== today.getFullYear()) {
                localStorage.removeItem('pendingdrawCard');
                console.log("Removed expired pending card");
                return;
              }
            } catch(e) {
              console.error("Error parsing pending card:", e);
              localStorage.removeItem('pendingdrawCard');
              return;
            }
            const cardBack = document.querySelector('.tarot-back');
            if (cardBack) {
              cardBack.style.pointerEvents = 'none';
              cardBack.style.opacity = '0.5';
              cardBack.title = "You already drew a card. Please sign up or login to draw another.";
              console.log("Pending card detected, draw element disabled");
            }
          }
        }
        checkPendingCard();
        
        // Fetch a random card from the API
        async function fetchRandomCard(apiBaseUrl) {
          console.log("Fetching random card from API:", apiBaseUrl);
          const res = await fetch(`${apiBaseUrl}/api/draw-card`);
          console.log("Fetch response status:", res.status);
          if (!res.ok) {
            const text = await res.text();
            console.log("Fetch error text:", text);
            throw new Error(text || "Failed to draw card");
          }
          const cardData = await res.json();
          console.log("Fetched card data:", cardData);
          return cardData;
        }
        
        // Generate an AI prompt for the card
        async function getAiPrompt(card, apiBaseUrl) {
          console.log("Generating AI prompt for card:", card);
          try {
            const resp = await fetch(`${apiBaseUrl}/api/generate-prompt`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                cardName: card.card_name,
                orientation: card.orientation,
                meanings: card.meanings
              })
            });
            console.log("AI prompt response status:", resp.status);
            if (resp.ok) {
              const data = await resp.json();
              console.log("AI prompt data:", data);
              return data.aiPrompt;
            }
            return "An error occurred generating a prompt.";
          } catch (err) {
            console.error("Prompt error:", err);
            return "An error occurred generating a prompt.";
          }
        }
        
        async function updateCardUI(card, apiBaseUrl) {
          console.log("Updating card UI with card:", card);
          window.drawnCard = card;

          const cardWrapper = document.querySelector('.card-wrapper');
          const frontImage = document.getElementById('drawn-card');
          const cardTitleElement = heroText.querySelector('h1');
          const cardPromptElement = heroText.querySelector('p');
          const isReversed = card.orientation.toLowerCase() === 'reversed';

          // Preload image first
          frontImage.src = card.image_data;
          await new Promise(resolve => frontImage.onload = resolve);

          // Initial setup
          cardTitleElement.innerHTML = '';
          cardPromptElement.innerHTML = '';
          responseBox.classList.add('hidden');
          saveButton.classList.add('hidden');

          // Mobile-specific positioning
          if (window.matchMedia("(max-width: 1099px)").matches) {
            heroText.classList.add('initial-load');
            await new Promise(resolve => {
              // Wait for next frame to apply styles
              requestAnimationFrame(() => {
                heroText.classList.add('reveal');
                heroText.style.display = 'block';
                resolve();
              });
            });
          } else {
            // Reset hero-text positioning first
            heroText.style.position = 'fixed';
            heroText.style.top = '50%';
            heroText.style.right = '5%';
            heroText.style.transform = 'translateY(-50%)';
            heroText.style.marginTop = '0';
          }
          
          cardWrapper.classList.remove('flipped');
          void cardWrapper.offsetWidth; // Force reflow

          if (isReversed) {
            cardWrapper.classList.add('flipped', 'reversed');
          } else {
            cardWrapper.classList.add('flipped');
          }

          // Wait for flip animation to complete
          await new Promise(resolve => setTimeout(resolve, 800));

          frontImage.dataset.cardId = card.card_id;
          
          // Fade in card title
          cardTitleElement.textContent = `${card.card_name} (${card.orientation})`;
          fadeIn(cardTitleElement);

          const aiPrompt = await getAiPrompt(card, apiBaseUrl);

          // Typewriter effect for prompt
          let i = 0;
          const speed = 1; // typing speed in ms
          const cursor = '<span class="typing-cursor"></span>';

          function typeWriter() {
            if (i < aiPrompt.length) {
              cardPromptElement.innerHTML = aiPrompt.substring(0, i + 1) + cursor;
              i++;
              setTimeout(typeWriter, speed);
            } else {
              cardPromptElement.innerHTML = aiPrompt;
              // Show response box and save button after typing completes
              responseBox.classList.remove('hidden');
              saveButton.classList.remove('hidden');
              fadeIn(responseBox);
              fadeIn(saveButton);
            }
          }

          // Start typing effect after title fades in
          setTimeout(typeWriter, 600);
          makeHeroTextScrollable();
        }

        function makeHeroTextScrollable() {
          const heroText = document.getElementById('hero-text');
          const cardPromptElement = heroText.querySelector('p');
          // Get the current offset of the fixed element relative to the viewport.
          heroText.style.position = 'relative';
          heroText.style.top = '0';
          heroText.style.left = 'auto';
          heroText.style.marginLeft = 'auto';
          heroText.style.transform = 'none';
          cardPromptElement.style.textAlign = 'left';
          heroText.style.marginTop = '5rem';

          // Display remains block if visible
          if (heroText.style.opacity !== '0') {
            heroText.style.display = 'block';
          }
        }
        
        // Handle the card draw when the card image or button is clicked
        async function handleDrawCard() {
          console.log("handleDrawCard invoked");
          if (!user) {
            const pending = localStorage.getItem('pendingdrawCard');
            if (pending) {
              console.log("User not logged in and pending card exists");
              alert('You already drew a card. Please sign up or login to draw another.');
              return;
            }
          }
          isDrawing = true;
          spinner.style.display = 'block';

          // Only fade out the CTA buttons, not the entire hero-text
          drawButton.style.opacity = '0';
          writeButton.style.opacity = '0';

          try {
            const card = await fetchRandomCard(API_BASE_URL);
            card.timestamp = new Date().toISOString(); // Add time stamp

            // Keep hero-text visible during animations
            heroText.style.display = 'block';
            heroText.style.opacity = '1';

            await updateCardUI(card, API_BASE_URL);
            
            if (!user) {
              localStorage.setItem('pendingdrawCard', JSON.stringify(card));
              console.log("Pending card saved in localStorage");
            }
          } catch (err) {
            console.error("Error in handleDrawCard:", err);
            alert('Something happened on our end, please try again later.');
          } finally {
            isDrawing = false;
            spinner.style.display = 'none';
            console.log("handleDrawCard completed");
          }
        }

        // Add save functionality
        document.getElementById('save-response-btn')?.addEventListener('click', async () => {
          const responseBox = document.getElementById('response-1');
          const cardPrompt = document.querySelector('#hero-text p');
          const moodSlider = document.getElementById("mood-slider");

          if (!responseBox || !cardPrompt) return;

          const responseText = responseBox.value.trim();
          const promptText = cardPrompt.textContent?.trim();
          
          if (!responseText || !promptText) {
            alert("Please fill out your journal response.");
            return;
          }

          const payload = {
            card_id: window.drawnCard?.card_id,
            orientation: window.drawnCard?.orientation,
            prompt_text: promptText,
            response_text: responseText,
            selected_meanings: window.drawnCard?.selectedMeanings || [],
            mood: parseInt(moodSlider?.value || 3, 10),
            timestamp: new Date().toISOString()
          };

          if (user) {
            try {
              await sendResponseToApi(payload, user, API_BASE_URL);
              alert("Your response was saved successfully!");
              localStorage.removeItem('pendingdrawCard');
              resetCardUI();
            } catch (err) {
              console.error(err);
              alert(`Failed to save. Please try again later.`);
            }
          } else {
            storeResponseInLocalStorage(payload);
            showMakeAccountModal();
          }
        });

        function resetCardUI() {
          const cardWrapper = document.querySelector('.card-wrapper');
          const frontImage = document.getElementById('drawn-card');
          const heroText = document.getElementById('hero-text');
          
          // Reset card UI
          if (cardWrapper) {
            cardWrapper.classList.remove('flipped');
            cardWrapper.style.transform = '';
            frontImage.src = "https://raw.githubusercontent.com/SenergyGroup/tarotlog_assets/refs/heads/main/deck_backs/tarot-card-default.webp";
            frontImage.style.transform = '';
          }
          
          // Reset hero text
          if (heroText) {
            // Remove all positioning-related inline styles
            heroText.style.removeProperty('position');
            heroText.style.removeProperty('top');
            heroText.style.removeProperty('right');
            heroText.style.removeProperty('left');
            heroText.style.removeProperty('transform');
            heroText.style.removeProperty('margin-top');
            heroText.style.removeProperty('margin-left');
            
            // Let CSS classes handle positioning
            heroText.classList.add('reset-state');
            heroText.querySelector('h1').textContent = "The Cards Remember";
            heroText.querySelector('p').textContent = "But without an account, we wont. Keep it safe — create an account.";
            document.getElementById('response-1').value = '';
          }
          
          responseBox.classList.add('hidden');
          saveButton.classList.add('hidden');
          window.drawnCard = null;
        }

        // Update event listener binding for card click
        document.querySelector('.card-wrapper')?.addEventListener('click', async () => {
          if (!isDrawing) {
            await handleDrawCard();
          }
        });

        // Add helper functions from drawCard
        function storeResponseInLocalStorage(payload) {
          const localEntries = JSON.parse(localStorage.getItem('tarotOfflineEntries') || '[]');
          localEntries.push(payload);
          localStorage.setItem('tarotOfflineEntries', JSON.stringify(localEntries));
        }

        async function sendResponseToApi(payload, user, apiBaseUrl) {
          const fullPayload = { ...payload, user_id: user.id };
          const res = await fetch(`${apiBaseUrl}/api/save-response`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(fullPayload)
          });
          if (!res.ok) throw new Error(await res.text());
        }

        // Ensure modal functions exist
        function showMakeAccountModal() {
          const overlay = document.getElementById('account-modal-overlay');
          if (!overlay) return;
          overlay.classList.remove('hidden');

          document.getElementById('modal-make-account-btn').onclick = () => {
            location.href = "/auth/signup";
          };

          document.getElementById('modal-lose-data-btn').onclick = () => {
            overlay.classList.add('hidden');
            localStorage.removeItem('pendingdrawCard');
            localStorage.removeItem('tarotOfflineEntries');
            resetCardUI();
          };
        }
        
        // Bind the drawn card and draw button click events
        const drawnCardElem = document.getElementById('drawn-card');
        const drawBtn = document.getElementById('draw-btn');
        if (drawnCardElem) {
          drawnCardElem.addEventListener('click', async () => {
            console.log("drawn-card element clicked");
            if (!isDrawing) {
              await handleDrawCard();
            }
          });
        }
        if (drawBtn) {
          drawBtn.addEventListener('click', async () => {
            console.log("Draw button clicked");
            if (!isDrawing) {
              await handleDrawCard();
            }
          });
        }
      });
    </script>
  </body>
  </html>