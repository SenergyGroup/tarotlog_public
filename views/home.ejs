<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MyTarotTales</title>
    <link rel="stylesheet" href="/styles.css">   
    <script src="/profile.js"></script>
</head>
<body class="bg-gradient">
<div class="landing-container">
  <div class="hero-section">
    <h1 class="gradient-text">MyTarotTales</h1>
    <p class="hero-subtitle">Draw a card for a personalized prompt, or free journal to match a card with your entry. Track your insights and review your progress, one card at a time.</p>
    
    <div class="auth-buttons">
      <div class="btn btn-primary" onclick="window.location.href='/auth/login'">
        Sign In
      </div>
      <div class="btn btn-outline" onclick="window.location.href='/auth/signup'">
        Sign Up
      </div>
    </div>
  </div>

  <div class="features-grid">
    <div class="feature-card card glass">
      <div class="feature-icon">🎴</div>
      <h3>Generated Prompts</h3>
      <p>Get prompts based on tarot cards</p>
    </div>
    
    <div class="feature-card card glass">
      <div class="feature-icon">📖</div>
      <h3>Journal Your Journey</h3>
      <p>Record your reflections and track your growth</p>
    </div>
    
    <div class="feature-card card glass">
      <div class="feature-icon">🔮</div>
      <h3>Get Matched</h3>
      <p>Get paired with the tarot card that best reflects your entry</p>
    </div>
  </div>
</div>
