<%- include('partials/header'); -%>

<script src="https://cdn.jsdelivr.net/npm/jwt-decode/build/jwt-decode.min.js"></script>
<script>
    const user = <%- JSON.stringify(user) %>;
</script>

<script src="/script.js"></script>
<script src="/profile.js"></script>

<div class="app-container">
    <div class="card-section">
        <div class="card-container">
            <img id="drawn-card" src="https://raw.githubusercontent.com/SenergyGroup/tarotlog_assets/refs/heads/main/image_back.png" alt="Facedown Card" class="card-image">
        </div>
        <button id="draw-card-btn" class="draw-button">Draw a Card</button>
        
        <div class="card-header hidden">
            <h2 id="card-title"></h2>
        </div>
    </div>
    
    <div class="prompt-section hidden">
        <p id="card-prompt" class="prompt-text"></p>

        <!-- Mood Input Section -->
        <div class="mood-slider-container">
            <label for="mood-slider">Mood:</label>
            <div class="slider-wrapper">
                <span class="slider-icon" id="sad-icon">😞</span>
                <input type="range" id="mood-slider" name="mood" min="1" max="5" value="3">
                <span class="slider-icon" id="happy-icon">😊</span>
            </div>
            <p id="mood-display">Mood: 😐 (3)</p>
        </div>
        

        <textarea id="response-1" class="response-box" placeholder="Your answer to the prompt..."></textarea>
        <button id="save-response-btn" class="save-button">Save Response</button>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const moodSlider = document.getElementById("mood-slider");
        const moodDisplay = document.getElementById("mood-display");

        const moodMap = {
            1: "😞",
            2: "😒",
            3: "😐",
            4: "🙂",
            5: "😊",
        };

        const updateMoodDisplay = (value) => {
            const moodIcon = moodMap[value] || "😐"; // Default to neutral
            moodDisplay.textContent = `${moodIcon} (${value})`;
        };

        // Initial mood display
        updateMoodDisplay(moodSlider.value);

        // Update mood display on slider change
        moodSlider.addEventListener("input", () => {
            updateMoodDisplay(moodSlider.value);
        });
    });
</script>

<%- include('partials/footer'); -%>
