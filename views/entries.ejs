<%- include('partials/header'); -%>

<script src="https://cdn.jsdelivr.net/npm/jwt-decode/build/jwt-decode.min.js"></script>
<script>
    const user = <%- JSON.stringify(user) %>;
</script>
<script src="/profile.js"></script>

<div class="entry-list-page">
    <!-- Title -->
    <h1 class="page-title">Your Journal Entries</h1>
  
    <!-- Filter Section -->
    <div class="filter-container">
      <label for="filter-dropdown">Filter By:</label>
      <select id="filter-dropdown" class="filter-dropdown">
          <option value="most-recent">Most Recent</option>
          <option value="oldest">Oldest</option>
          <option value="card">Card</option>
      </select>
      <!-- Add a search bar and button -->
    <input type="text" id="search-bar" placeholder="Search entries..." />
    <button id="search-button">Search</button>
  </div>
  
  <!-- Entries List -->
  <ul class="entries-list">
    <% if (entries.length > 0) { %>
      <% 
          // Safer properCase function
          const properCase = (str) => {
            if (!str) return 'N/A'; // Fallback if orientation is missing
            return str.charAt(0).toUpperCase() + str.slice(1).toLowerCase();
          };
        %>
        <% entries.forEach(entry => { %>
          <li class="entry-item">
            <div class="entry-summary" data-entry-id="<%= entry.response_id %>">
              <span class="entry-date"><%= new Date(entry.created_at).toLocaleDateString() %></span>
              <span class="entry-card"><%= entry.card_name %></span>
              <span class="entry-orientation"><%= properCase(entry.orientation) %></span>
            </div>
            <div class="entry-details hidden">
              <p class="entry-prompt"><strong>Prompt:</strong> <%= entry.parsed_prompt_text %></p>
              <br>
              <p class="entry-response"><strong>Response:</strong> <%= entry.response_text %></p>
            </div>
          </li>
        <% }) %>
      <% } else { %>
        <li>No entries found.</li>
      <% } %>
  </ul>
</div>

<div class="pagination">
  <% if (currentPage > 1) { %>
      <a href="?page=<%= currentPage - 1 %>&filter=<%= filter %>">&laquo; Previous</a>
  <% } %>
  <% for (let i = 1; i <= totalPages; i++) { %>
      <a href="?page=<%= i %>&filter=<%= filter %>" class="<%= i === currentPage ? 'active' : '' %>"><%= i %></a>
  <% } %>
  <% if (currentPage < totalPages) { %>
      <a href="?page=<%= currentPage + 1 %>&filter=<%= filter %>">Next &raquo;</a>
  <% } %>
</div>

<script>
  document.getElementById('filter-dropdown').addEventListener('change', function () {
    const selectedFilter = this.value;
    const currentUrl = window.location.origin + window.location.pathname; // Preserve current URL
    window.location.href = `${currentUrl}?filter=${selectedFilter}`; // Redirect with query parameter
  });
</script>

<script>
  // Set the dropdown to the current filter value
  const urlParams = new URLSearchParams(window.location.search);
  const currentFilter = urlParams.get('filter') || 'most-recent';
  document.getElementById('filter-dropdown').value = currentFilter;
</script>

<script src="/filter.js"></script>

<style>
.pagination {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 20px;
}
.pagination a {
    text-decoration: none;
    padding: 10px;
    border: 1px solid #444;
    border-radius: 5px;
    color: #f2c14e;
}
.pagination a.active {
    background-color: #f2c14e;
    color: #1c1c1c;
}
.pagination a:hover {
    background-color: #444;
    color: #f2c14e;
}
</style>

  <%- include('partials/footer'); -%>