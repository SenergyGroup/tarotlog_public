<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>MyTarotTales</title>

  <!-- Main site stylesheet (if you have an external one, keep this link) -->
  <link rel="stylesheet" href="/styles.css"> 

  <!-- Include a decorative serif font (for headings & buttons) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link 
    href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&display=swap" 
    rel="stylesheet"
  >

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-JYXX0G315R"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-JYXX0G315R');
  </script>
  <script src="/profile.js"></script>
<style>
    .hero-swirls {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      background:
        linear-gradient(to right, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.95) 100%),
        url('https://raw.githubusercontent.com/SenergyGroup/tarotlog_assets/refs/heads/main/swirl-bg.jpg')
          center center / cover no-repeat;
     z-index: -1;
    }
    .btn {
      font-size: 1rem;
      padding: 0.8rem 1.5rem;
      border-radius: 50px;
      border: 2px solid #fff;
      background: transparent;
      color: #fff;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .btn:hover {
      background: #fff;
      color: #000;
      transform: translateY(-2px);
    }
</style>
<header>
    <h1 class="brand-title">
        <% if (user) { %>
        <a href="/dashboard">MyTarotTales</a>
        <% } else { %>
        <a href="/">MyTarotTales</a>
        <% } %>
    </h1>
</header>

<% if (resetSuccess) { %>
    <div class="alert alert-success show" data-timeout="4000">
        Password reset successfully. You can now log in.
    </div>
<% } %>
<div class="hero-swirls"></div>
<form action="/auth/login" method="POST">
    <h1>Sign In</h1>
    <div class="username error"></div>
    <label for="email">Email</label>
    <input type="text" name="email" required />
    <div class="email error"></div>
    <label for="password">Password</label>
    <input type="password" name="password" required />
    <div class="password error"></div>
    <button class="btn">Log in</button>
    <br>
    <br>
    <div class="social-login">
        <a href="/auth/google" class="btn-google">
            <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 0 24 24" width="24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/><path d="M1 1h22v22H1z" fill="none"/></svg>
            <span>Continue with Google</span>
        </a>
    </div>
</form>
<br>
<a href="/auth/forgot-password" class="forgot-password-link">Forgot Password?</a>


<!-- Success alert -->
<div class="overlay" id="overlay"></div>
<div class="alert-success" id="success-alert">
    Logging in...
</div>

<script>
const form = document.querySelector('form');
    const emailError = document.querySelector('.email.error');
    const passwordError = document.querySelector('.password.error');

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // reset errors
        emailError.textContent = '';
        passwordError.textContent = '';

        //get the values
        const email = form.email.value;
        const password = form.password.value;

        try {
            const res = await fetch('/auth/login', {
                method: 'POST',
                body: JSON.stringify({ email, password }),
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.errors) {
                emailError.textContent = data.errors.email;
                passwordError.textContent = data.errors.password;
            }
            if (data.userID) {
                const successAlert = document.getElementById("success-alert");
                const overlay = document.getElementById("overlay");

                successAlert.classList.add("show"); // Show the alert
                overlay.classList.add("show");

                setTimeout(() => {
                    successAlert.classList.remove("show");
                    overlay.classList.remove("show");
                    location.assign('/dashboard');
                }, 3000);
                
            }
            if (res.status === 401) {
                console.error('Login failed:', data.error);
            emailError.textContent = data.error.includes('Email') ? data.error : '';
            passwordError.textContent = data.error.includes('password') ? data.error : '';
            } else if (res.status === 500) {
            console.log('Server error:', data.error);
            }
        }
        catch (err) {
            console.log(err)
        }
    })
</script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Select all alerts with the `data-timeout` attribute
        const alerts = document.querySelectorAll('.alert[data-timeout]');

        alerts.forEach(alert => {
            const timeout = parseInt(alert.getAttribute('data-timeout'), 10) || 4000; // Default to 5000ms if not set

            setTimeout(() => {
                alert.classList.remove('show'); // Remove the `show` class to hide the alert
                alert.style.display = 'none'; // Optionally, set `display: none` to remove it from the layout
            }, timeout);
        });
    });
</script>
