<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MyTarotTales</title>
    <link rel="stylesheet" href="/styles.css">
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            if (window.innerWidth <= 768) {
                let lastScrollTop = window.pageYOffset || document.documentElement.scrollTop;
                const header = document.querySelector('header');
                const delta = 10; // minimal change in scroll to consider
                const topOffset = 25; // always show header if near the top

                window.addEventListener('scroll', () => {
                let st = window.pageYOffset || document.documentElement.scrollTop;
                
                // If close to the top, always show header
                if (st < topOffset) {
                    header.classList.remove('header-hidden');
                }
                // Only act if scroll difference is greater than delta
                else if (Math.abs(st - lastScrollTop) > delta) {
                    if (st > lastScrollTop && st > header.offsetHeight) {
                    // Scrolling down: hide header
                    header.classList.add('header-hidden');
                    } else if (st < lastScrollTop) {
                    // Scrolling up: show header
                    header.classList.remove('header-hidden');
                    }
                    lastScrollTop = st;
                }
                }, { passive: true });
            }
            });
</script>      
<!-- Load dependencies -->
<script src="https://d3js.org/d3.v7.min.js"></script>
<script src="https://unpkg.com/dayjs@1.11.7/dayjs.min.js"></script>
<script src="https://unpkg.com/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
<script src="https://d3js.org/d3-scale-chromatic.v1.min.js"></script>

<!-- Main Cal-Heatmap script + CSS -->
