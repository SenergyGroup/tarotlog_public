<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tarot Card Drawer</title>
    <link rel="stylesheet" href="/styles.css">
    <script src="/script.js"></script>
</head>

<body>
    <header>
        <nav>
            <div class="nav-left">
                <% if (user) { %>
                    <h1><a href="/tarot">TarotLog</a></h1>
                <% } else { %>
                    <h1><a href="/">TarotLog</a></h1>
                <% } %>
            </div>
            <div class="nav-center">
                <!-- Add content here if I want to have something-->
              </div>
              <div class="nav-right">
                <% if (user) { %>
                    <!-- Profile Circle with Dropdown -->
                    <div class="profile-menu">
                        <div class="profile-circle" id="profile-circle">👤</div> <!-- Placeholder for profile picture -->
                        <div class="dropdown-menu" id="dropdown-menu">
                            <p><strong><%= user.username %></strong></p>
                            <a href="/entries">Entries</a>
                            <a href="/data">Data</a>
                            <a href="/logout">Log Out</a>
                        </div>
                    </div>
                <% } else { %>
                    <h1><a href="/signup">Sign Up</a></h1>
                    <h1><a href="/login">Log In</a></h1>
                <% } %>
            </div>
        </nav>
    </header>
