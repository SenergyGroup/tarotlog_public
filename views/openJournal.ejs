<%- include('partials/header'); -%>
<script>
    window.user = <%- JSON.stringify(user || null) %>;
  </script>
<script src="/profile.js"></script>

<style>
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 9999;
    }
    
    .modal-box {
      background: linear-gradient(145deg, var(--muted), var(--background));
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 1rem;
      padding: 2rem;
      width: 90%;
      max-width: 400px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.7);
      color: var(--foreground);
      text-align: center;
    }
    
    .modal-title {
      font-size: 1.5rem;
      margin-bottom: 1rem;
      color: var(--primary);
    }
        
    .modal-buttons {
        display: flex;
        justify-content: center;
        gap: 1.5rem; /* ↑ increases space between buttons */
        margin-top: 1.5rem;
    }

    .modal-buttons .btn {
        flex: 1;
    }

    .card-footer {
      display: flex;
      justify-content: center;
      gap: 0.5rem;
      margin-top: 1rem;
    }

    /* Styles for all share buttons */
    .shareButton {
      border: none;
      border-radius: 50%;
      background: #fff;
      padding: 1rem;
      overflow: hidden;
      outline: none;
      margin: 0.5rem;
      width: 24px;
      height: 24px;
      box-sizing: content-box;
      transition: all 200ms;
      position: relative;
      cursor: pointer;
    }

    .shareButton:hover {
      transform: scale(1.1) translateY(-3px);
      box-shadow: 0 3px 6px rgba(0, 0, 0, 0.25);
    }
    .hidden {
      display: none !important;
    }
</style>

<div class="app-container">
    <h1 class="page-title gradient-text">Open Journal</h1>
    <p>Journal about whatever you feel like and discover the tarot card that best matches your entry</p>
  
    <div class="open-journal-section">
      <!-- Updated card container uses both "card" and "glass" for the modern translucent style -->
      <div class="card hidden sleek-card-container">
        <div class="card-header">
          <span>
            <h2 id="card-name"></h2>
            <h3 id="orientation"></h3>
          </span>
        </div>
        <div class="card-content">
          <img id="tarot-image" src="" alt="Tarot Card Image">
          <p id="reasoning"></p>
          <div class="card-footer">
            <button class="shareButton pin">
              <svg style="width:24px;height:24px" viewBox="0 0 24 24">
                <path d="M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146 1.124.347 2.317.535 3.554.535 6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"></path>
              </svg>
            </button>
            <button class="shareButton fb">
              <svg style="width:24px;height:24px" viewBox="0 0 24 24">
                <path d="M17,2V2H17V6H15C14.31,6 14,6.81 14,7.5V10H14L17,10V14H14V22H10V14H7V10H10V6A4,4 0 0,1 14,2H17Z"></path>
              </svg>
            </button>
            <button class="shareButton tw">
              <svg style="width:24px;height:24px" viewBox="0 0 24 24">
                <path d="M22.46,6C21.69,6.35 20.86,6.58 20,6.69C20.88,6.16 21.56,5.32 21.88,4.31C21.05,4.81 20.13,5.16 19.16,5.36C18.37,4.5 17.26,4 16,4C13.65,4 11.73,5.92 11.73,8.29C11.73,8.63 11.77,8.96 11.84,9.27C8.28,9.09 5.11,7.38 3,4.79C2.63,5.42 2.42,6.16 2.42,6.94C2.42,8.43 3.17,9.75 4.33,10.5C3.62,10.5 2.96,10.3 2.38,10C2.38,10 2.38,10 2.38,10.03C2.38,12.11 3.86,13.85 5.82,14.24C5.46,14.34 5.08,14.39 4.69,14.39C4.42,14.39 4.15,14.36 3.89,14.31C4.43,16 6,17.26 7.89,17.29C6.43,18.45 4.58,19.13 2.56,19.13C2.22,19.13 1.88,19.11 1.54,19.07C3.44,20.29 5.7,21 8.12,21C16,21 20.33,14.46 20.33,8.79C20.33,8.6 20.33,8.42 20.32,8.23C21.16,7.63 21.88,6.87 22.46,6Z"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>
      
      <input type="text" id="journal-title" name="title" placeholder="Journal title" required>
      
      <textarea id="response-2" class="open-journal-response-box" placeholder="Let your thoughts run free"></textarea>
      
      <!-- Mood Input Section remains the same -->
      <div class="mood-slider-container">
        <label for="mood-slider">Mood:</label>
        <div class="slider-wrapper">
          <span class="slider-icon" id="sad-icon">😞</span>
          <input type="range" id="mood-slider" name="mood" min="1" max="5" value="3">
          <span class="slider-icon" id="happy-icon">😊</span>
        </div>
        <p id="mood-display">Mood: 😐 (3)</p>
      </div>
      
      <!-- Updated button class -->
      <button id="save-response-btn" class="btn btn-primary">Save Response</button>
    </div>
</div>

<script>
    document.getElementById("save-response-btn").addEventListener("click", async () => {
        const journalEntry = document.getElementById("response-2").value;
        const mood = document.getElementById("mood-slider").value;
        const title = document.getElementById("journal-title").value;

        if (!journalEntry) {
            alert("Please enter your journal entry.");
            return;
        }

        const saveButton = document.getElementById("save-response-btn");
        saveButton.disabled = true;
        saveButton.innerText = "Saving...";

        try {
            const response = await fetch("/get-tarot-card", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ journalEntry, mood, title }),
            });

            if (!response.ok) {
                const errorData = await response.json();
                throw new Error(errorData.error || 'Failed to fetch card');
            }

            const data = await response.json();

            // Update the UI with the card details
            document.getElementById("card-name").innerText = `Card: ${data.card_name}`;
            document.getElementById("orientation").innerText = `(${data.orientation})`;
            document.getElementById("reasoning").innerText = data.reasoning;

            const image = document.getElementById("tarot-image");
            image.src = data.image_data;
            image.alt = `${data.card_name} Tarot Card`;
            image.style.transform = data.orientation === 'reversed' ? 'rotate(180deg)' : 'rotate(0deg)';

            // Unhide card details
            document.querySelector(".sleek-card-container").classList.remove("hidden");

            resetOpenJournalUI();
            updateShareButtons(data);
        } catch (error) {
            console.error("Error:", error);
            alert(`Failed to fetch tarot card. Please try again later.`);
        } finally {
            saveButton.disabled = false;
            saveButton.innerText = "Save Response";
        }
    });

    function resetOpenJournalUI() {
        const journalTitle = document.getElementById("journal-title");
        const moodSliderContainer = document.querySelector(".mood-slider-container");
        const journalEntry = document.getElementById("response-2");
        const saveButton = document.getElementById("save-response-btn");
        const cardContainer = document.querySelector(".sleek-card-container");

        // Hide the journal title input field
        if (journalTitle) {
            journalTitle.classList.add("hidden");
        }

        // Hide the mood slider container
        if (moodSliderContainer) {
            moodSliderContainer.classList.add("hidden");
        }

        // Hide the journal entry text area
        if (journalEntry) {
            journalEntry.classList.add("hidden");
        }

        // Hide the save button
        if (saveButton) {
            saveButton.classList.add("hidden");
        }

        // Ensure the card container is visible
        if (cardContainer) {
            cardContainer.classList.remove("hidden");
        }
    }

    function updateShareButtons(card) {
      try {
        // Base homepage URL
        const baseUrl = 'https://www.mytarottales.com/';
        
        // Capture the current user's ID if available; otherwise mark as anonymous
        const referrerId = user && user.id ? user.id : 'anonymous';
        
        // Personalized share text based on the drawn card
        const shareText = `Today, my day most aligned with ${card.card_name}!`;
        
        // Create a common URL with UTM parameters and the referrer
        const createShareUrl = (source) => {
          return `${baseUrl}?utm_source=${source}&utm_medium=social&utm_campaign=tarot_share&referrer=${referrerId}`;
        };

        // Facebook share button
        const fbShareButton = document.querySelector('.shareButton.fb');
        if (fbShareButton) {
          fbShareButton.onclick = () => {
            try {
              const fbUrl = createShareUrl('facebook');
              console.log('Facebook Share URL:', fbUrl);
              console.log('Facebook Share Text:', shareText);
              window.open(
                `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(fbUrl)}&t=${encodeURIComponent(shareText)}`,
                'sharewindow',
                'width=750,height=550'
              );
            } catch (err) {
              console.error('Error in Facebook share button:', err);
            }
            return false;
          };
        } else {
          console.warn('Facebook share button not found.');
        }

        // Twitter share button
        const twShareButton = document.querySelector('.shareButton.tw');
        if (twShareButton) {
          twShareButton.onclick = () => {
            try {
              const twUrl = createShareUrl('twitter');
              console.log('Twitter Share URL:', twUrl);
              console.log('Twitter Share Text:', shareText);
              window.open(
                `https://twitter.com/intent/tweet?url=${encodeURIComponent(twUrl)}&text=${encodeURIComponent(shareText)}`,
                'sharewindow',
                'width=750,height=550'
              );
            } catch (err) {
              console.error('Error in Twitter share button:', err);
            }
            return false;
          };
        } else {
          console.warn('Twitter share button not found.');
        }

        // Pinterest share button
        const pinShareButton = document.querySelector('.shareButton.pin');
        if (pinShareButton) {
          pinShareButton.onclick = () => {
            try {
              const pinUrl = createShareUrl('pinterest');
              console.log('Pinterest Share URL:', pinUrl);
              console.log('Pinterest Share Text:', shareText);
              console.log('Pinterest Media URL:', card.image_data);
              window.open(
                `https://pinterest.com/pin/create/button/?description=${encodeURIComponent(shareText)}&url=${encodeURIComponent(pinUrl)}&media=${encodeURIComponent(card.image_data)}&`,
                'sharewindow',
                'width=750,height=550'
              );
            } catch (err) {
              console.error('Error in Pinterest share button:', err);
            }
            return false;
          };
        } else {
          console.warn('Pinterest share button not found.');
        }
      } catch (error) {
        console.error('Error in updateShareButtons:', error);
      }
    }

</script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const moodSlider = document.getElementById("mood-slider");
        const moodDisplay = document.getElementById("mood-display");

        const moodMap = {
            1: "😞",
            2: "😒",
            3: "😐",
            4: "🙂",
            5: "😊",
        };

        const updateMoodDisplay = (value) => {
            const moodIcon = moodMap[value] || "😐"; // Default to neutral
            moodDisplay.textContent = `${moodIcon} (${value})`;
        };

        // Initial mood display
        updateMoodDisplay(moodSlider.value);

        // Update mood display on slider change
        moodSlider.addEventListener("input", () => {
            updateMoodDisplay(moodSlider.value);
        });
    });
</script>

<%- include('partials/footer'); -%>
