<%- include('partials/header'); -%>

<div class="store-container">
    <h1>Welcome to the Store</h1>
    <p>Explore themes, cards, and artwork. Coming soon!</p>
    <div class="store-grid">
        <div class="store-item">
            <img src="/images/theme-placeholder.png" alt="Theme Placeholder">
            <h2>Custom Themes</h2>
            <p>Personalize your journaling experience.</p>
        </div>
        <div class="store-item">
            <img src="/images/cards-placeholder.png" alt="Cards Placeholder">
            <h2>Tarot Cards</h2>
            <p>Discover unique tarot designs.</p>
        </div>
        <div class="store-item">
            <img src="/images/artwork-placeholder.png" alt="Artwork Placeholder">
            <h2>Artwork</h2>
            <p>Enhance your space with inspiring art.</p>
        </div>
    </div>
</div>

<%- include('partials/footer'); -%>

<style>
    .store-container {
        text-align: center;
        padding: 20px;
    }
    .store-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }
    .store-item {
        background-color: #2e2e2e;
        border: 1px solid #444;
        border-radius: 8px;
        padding: 15px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
    }
    .store-item img {
        max-width: 100%;
        border-radius: 5px;
    }
    .store-item h2 {
        color: #f5c542;
        margin: 10px 0;
    }
</style>
