                                deck_back === 'image_back_2' ? 'Landscape' : 
                                deck_back === 'image_back_3' ? 'Space' : 
                                deck_back === 'image_back_4' ? 'Sun and Moon' : 
                                deck_back === 'image_back_5' ? 'Mystic Tarot' : 
                                deck_back === 'image_back_6' ? 'Sunset Waves' : 
                                deck_back === 'image_back_7' ? 'Archangel' : 'Select Deck Back' %>
