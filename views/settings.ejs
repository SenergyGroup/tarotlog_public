            <h2>Billing</h2>
            <p>You are currently a <strong>premium user</strong>. Enjoy all features while we are in the testing phase!</p>
        </div>
        <!-- Login & Security Section -->
        <div id="login-security" class="settings-section">
            <h2>Login & Security</h2>
            <form action="/settings/security" method="POST">
                <!--<label for="username">Change Username:</label>-->
                <!--<input type="text" id="username" name="username" placeholder="New Username">-->
        
                <!--<label for="email">Change Email:</label>-->
                <!--<input type="email" id="email" name="email_old" placeholder="Previous Email">-->
                <!--<input type="email" id="email" name="email_new" placeholder="New Email">-->

                <!--<br>

                <button type="submit">Save Changes</button>

                <br>
                <br>-->
                <button type="button" onclick="location.href='/auth/change-password'">Change Password</button>

                <button type="button" onclick="location.href='/settings/download-data'">Download My Data</button>

                <!--<button type="button" onclick="location.href='/settings/deactivate'">Deactivate My Account</button>-->
                <!--<p><strong>Warning!</strong> Deleting your account deletes all of your data.</p>-->
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const navItems = document.querySelectorAll('.settings-nav li');
        const sections = document.querySelectorAll('.settings-section');

        navItems.forEach(item => {
            item.addEventListener('click', () => {
                // Remove active class from all
                navItems.forEach(nav => nav.classList.remove('active'));
                sections.forEach(section => section.classList.remove('active'));

                // Add active class to selected
                item.classList.add('active');
                document.getElementById(item.dataset.section).classList.add('active');
            });
        });
    });
</script>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const dropdown = document.getElementById("deck-back-dropdown");
    const selectedOption = document.getElementById("selected-deck-back");
    const dropdownOptions = document.getElementById("deck-back-options");
    const selectedText = document.getElementById("selected-deck-back-text");
    const hiddenInput = document.getElementById("deck_back_hidden");

    // Toggle dropdown when clicking on the selected option box
    selectedOption.addEventListener("click", function() {
      const isVisible = dropdownOptions.style.display === "block";
      dropdownOptions.style.display = isVisible ? "none" : "block";
    });

    // Close dropdown if click outside
    document.addEventListener("click", function(event) {
      if (!dropdown.contains(event.target)) {
        dropdownOptions.style.display = "none";
      }
    });

    // Set up click handler for each option
    const options = dropdownOptions.querySelectorAll(".dropdown-option");
    options.forEach(function(option) {
      option.addEventListener("click", function() {
        const value = option.getAttribute("data-value");
        const name = option.getAttribute("data-name");
        // Update the visible text and hidden input
        selectedText.textContent = name;
        hiddenInput.value = value;
        // Hide the options dropdown
        dropdownOptions.style.display = "none";
      });
    });
  });
</script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
      const cardThemeDropdown = document.getElementById("card-theme-dropdown");
      const selectedCardTheme = document.getElementById("selected-card-theme");
      const cardThemeOptions = document.getElementById("card-theme-options");
      const selectedCardThemeText = document.getElementById("selected-card-theme-text");
      const deckPreferenceHidden = document.getElementById("deck_preference_hidden");
  
      // Toggle dropdown visibility when clicking the selected area
      selectedCardTheme.addEventListener("click", function() {
        const isVisible = cardThemeOptions.style.display === "block";
        cardThemeOptions.style.display = isVisible ? "none" : "block";
      });
  
      // Close dropdown if clicking outside
      document.addEventListener("click", function(event) {
        if (!cardThemeDropdown.contains(event.target)) {
          cardThemeOptions.style.display = "none";
        }
      });
  
      // Set up click handler for each dropdown option
      const options = cardThemeOptions.querySelectorAll(".dropdown-option");
      options.forEach(function(option) {
        option.addEventListener("click", function() {
          const value = option.getAttribute("data-value");
          const name = option.getAttribute("data-name");
          // Update the displayed text and hidden input value
          selectedCardThemeText.textContent = name;
          deckPreferenceHidden.value = value;
          // Hide the dropdown options
          cardThemeOptions.style.display = "none";
        });
      });
    });
  </script>

