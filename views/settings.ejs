<%- include('partials/header'); -%>
<script src="/profile.js"></script>
<style>
    .custom-dropdown {
        position: relative;
        width: 220px; /* Adjust as needed */
        font-family: sans-serif;
      }
      
      .selected-option {
        padding: 10px;
        border: 1px solid #ccc;
        background: #2e2e2e;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: #fff;
      }
      
      .arrow-icon {
        margin-left: 10px;
      }
      
      .dropdown-options {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        max-height: 200px;
        overflow-y: auto;
        background: #2e2e2e;
        border: 1px solid #ccc;
        z-index: 100;
      }
      
      .dropdown-option {
        display: flex;
        align-items: center;
        padding: 5px;
        cursor: pointer;
        transition: background 0.2s ease;
      }
      
      .dropdown-option:hover {
        background: #7a4b9f;
      }
      
      .dropdown-option img {
        width: 40px;
        height: auto;
        margin-right: 10px;
      }
      input {
        width: 100%;
      }
</style>

<div class="settings-container">
    <nav class="settings-nav">
        <ul>
            <li data-section="general" class="active">General</li>
            <!-- <li data-section="notifications">Notifications</li> -->
            <li data-section="billing">Billing</li>
            <li data-section="login-security">Login & Security</li>
        </ul>
    </nav>
    <div class="settings-content">
        <div id="general" class="settings-section active">
            <h2>General Settings</h2>
            <form action="/settings/general" method="POST">
                <!-- Profile Pic Selection -->
                <!--<label for="profile-pic">Upload Profile Picture:</label> -->
                <!--<input type="file" id="profile-pic" name="profile_pic" accept="image/*"> -->
                
                <!-- Card Back Selection -->
                <label for="card-back">Card Back:</label>
                    <div class="custom-dropdown" id="deck-back-dropdown">
                        <!-- This is the visible part that shows the selected option -->
                        <div class="selected-option" id="selected-deck-back">
                        <span id="selected-deck-back-text">
