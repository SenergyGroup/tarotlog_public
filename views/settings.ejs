                <input type="hidden" name="deck_preference" id="deck_preference_hidden" value="<%= deck_preference %>">
                </div>
        
                <!-- Focus Area -->
                <label for="focus">Focus for Journaling:</label>
                <select id="focus" name="focus">
                    <option value="self_growth" <%= focus === 'self_growth' ? 'selected' : '' %>>Self Growth</option>
                    <option value="career" <%= focus === 'career' ? 'selected' : '' %>>Career</option>
                    <option value="romance" <%= focus === 'romance' ? 'selected' : '' %>>Romance</option>
                    <option value="spirituality" <%= focus === 'spirituality' ? 'selected' : '' %>>Spirituality</option>
