                        <span class="arrow-icon">▼</span>
                        </div>
                        <!-- This is the hidden dropdown list with the image options -->
                        <div class="dropdown-options" id="deck-back-options">
                            <div class="dropdown-option" data-value="image_back_1" data-name="Artistic Sky">
                            <img src="https://raw.githubusercontent.com/SenergyGroup/tarotlog_assets/refs/heads/main/deck_backs/image_back_1.png" alt="Artistic Sky">
                            <span>Artistic Sky</span>
                            </div>
                            <div class="dropdown-option" data-value="image_back_2" data-name="Landscape">
                            <img src="https://raw.githubusercontent.com/SenergyGroup/tarotlog_assets/refs/heads/main/deck_backs/image_back_2.png" alt="Landscape">
                            <span>Landscape</span>
                            </div>
                            <div class="dropdown-option" data-value="image_back_3" data-name="Space">
                            <img src="https://raw.githubusercontent.com/SenergyGroup/tarotlog_assets/refs/heads/main/deck_backs/image_back_3.png" alt="Space">
                            <span>Space</span>
                            </div>
                            <div class="dropdown-option" data-value="image_back_4" data-name="Sun and Moon">
                            <img src="https://raw.githubusercontent.com/SenergyGroup/tarotlog_assets/refs/heads/main/deck_backs/image_back_4.png" alt="Sun and Moon">
                            <span>Sun and Moon</span>
                            </div>
                            <div class="dropdown-option" data-value="image_back_5" data-name="Mystic Tarot">
                            <img src="https://raw.githubusercontent.com/SenergyGroup/tarotlog_assets/refs/heads/main/deck_backs/image_back_5.png" alt="Mystic Tarot">
                            <span>Mystic Tarot</span>
                            </div>
                            <div class="dropdown-option" data-value="image_back_6" data-name="Sunset Waves">
                            <img src="https://raw.githubusercontent.com/SenergyGroup/tarotlog_assets/refs/heads/main/deck_backs/image_back_6.png" alt="Sunset Waves">
                            <span>Sunset Waves</span>
                            </div>
                            <div class="dropdown-option" data-value="image_back_7" data-name="Archangel">
                            <img src="https://raw.githubusercontent.com/SenergyGroup/tarotlog_assets/refs/heads/main/deck_backs/image_back_7.png" alt="Archangel">
                            <span>Archangel</span>
                            </div>
                        </div>
                        <!-- Hidden input to hold the value for form submission -->
                        <input type="hidden" name="deck_back" id="deck_back_hidden" value="<%= deck_back %>">
                    </div>
        
                <!-- Active Card Theme -->
                <label for="deck_preference">Active Card Theme:</label>
                <div class="custom-dropdown" id="card-theme-dropdown">
                <!-- Visible part that shows the selected option -->
                <div class="selected-option" id="selected-card-theme">
                    <span id="selected-card-theme-text">
                    <%= deck_preference === 'rider_white' ? 'Rider-Waite' : 
                        deck_preference === 'clown_tarot' ? 'Clown Town Tarot' : 
                        deck_preference === 'anecdotes' ? 'Anecdotes' : 
                        deck_preference === 'arlecchinos' ? 'Arlecchinos' : 'Select Deck' %>
                    </span>
                    <span class="arrow-icon">▼</span>
                </div>
                
                <!-- Hidden dropdown list with image options -->
                <div class="dropdown-options" id="card-theme-options">
                    <div class="dropdown-option" data-value="rider_white" data-name="Rider-Waite">
                    <img src="https://raw.githubusercontent.com/SenergyGroup/tarotlog_assets/refs/heads/main/tarot_decks/rider_white/image_1.jpg" alt="Rider-Waite">
                    <span>Rider-Waite</span>
