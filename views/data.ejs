<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<!-- <script src="https://unpkg.com/cal-heatmap/dist/cal-heatmap.min.js"></script> -->
<!-- <link rel="stylesheet" href="https://unpkg.com/cal-heatmap/dist/cal-heatmap.css"> -->

<div class="data-container">
    <h1 class="page-title">Your Journal Stats</h1>

    <!-- Calendar Heatmap Container -->
    <div class="stat-section">
        <h2>Journaling Habits</h2>
        <div id="journal-calendar"></div>
        <div class="button-container">
            <a href="#" class="button" id="prev">← Previous</a>
            <a href="#" class="button" id="next">Next →</a>
        </div>
    </div>

    <!-- Suit Polar Chart-->
    <div class="stat-section">
        <h2>Card Suit Distribution</h2>
        <canvas id="suitChart" width="400" height="400"></canvas>
    </div>

    <div class="stat-section">
        <h2>Mood Over Time</h2>
        <!-- Filter Form -->
        <form method="get" action="/data" class="filter-form">
            <label for="start">Start Date:</label>
            <input type="date" id="start" name="start" value="<%= start || '' %>">
            
            <label for="end">End Date:</label>
            <input type="date" id="end" name="end" value="<%= end || '' %>">

            <button type="submit">Filter</button>
        </form>
        
        <div class="chart-wrapper">
            <canvas id="moodChart"></canvas>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", async () => {
        const ctx = document.getElementById('suitChart').getContext('2d');

        const suitsData = <%- JSON.stringify(suitsData) %>;

        const labels = suitsData.map(item => item.suit); // Suit names
        const counts = suitsData.map(item => item.count); // Suit counts

        // Create the Polar Area Chart
        // Define colors for the suits
        const colors = [
            'rgba(231, 76, 60, 0.8)',  // Major Arcana
            'rgba(52, 152, 219, 0.8)', // Pentacles
            'rgba(241, 196, 15, 0.8)', // Wands
            'rgba(46, 204, 113, 0.8)', // Cups
            'rgba(155, 89, 182, 0.8)'  // Swords
        ];

        // Define border colors for more contrast
        const borderColors = colors.map(color => color.replace('0.8', '1'));

        // Create the Polar Area Chart
        new Chart(ctx, {
            type: 'polarArea',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Card Suit Counts',
                    data: counts,
                    backgroundColor: colors,
                    borderColor: borderColors,
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                animation: {
                    animateScale: true, // Smooth scaling animation
                    animateRotate: true // Smooth rotation animation
                },
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: '#f5c542', // Matches your theme
                            font: {
                                family: 'Cinzel',
                                size: 16
                            },
                            boxWidth: 20
                        },
                    },
                    tooltip: {
                        enabled: true,
                        backgroundColor: '#2e2e2e',
                        titleColor: '#f5c542',
                        bodyColor: '#f2c14e',
                        bodyFont: {
                            family: 'Cinzel',
                            size: 14
                        },
                        padding: 12,
                        borderColor: '#f5c542',
                        borderWidth: 1,
                        callbacks: {
                            label: (tooltipItem) => {
                                const suit = labels[tooltipItem.dataIndex];
                                const count = counts[tooltipItem.dataIndex];
                                return `${suit}: ${count} draws`;
                            }
                        }
                    }
                },
                scales: {
                    r: {
                        grid: {
                            color: 'rgba(245, 197, 66, 0.2)',
                            circular: true
                        },
                        ticks: {
                            color: '#f5c542',
                            showLabelBackdrop: false,
                            stepSize: 5
                        }
                    }
                }
            }
        });

        // Add mood chart setup here
        const moodCtx = document.getElementById('moodChart').getContext('2d');
        const moodsData = <%- JSON.stringify(moodsData) %>;
        const dates = moodsData.map(entry => new Date(entry.date).toLocaleDateString());
        const moods = moodsData.map(entry => parseFloat(entry.mood));

        new Chart(moodCtx, {
            type: 'line',
            data: {
                labels: dates,
                datasets: [{
                    label: 'Mood Level',
                    data: moods,
                    borderColor: '#f5c542',
                    backgroundColor: 'rgba(245, 197, 66, 0.2)',
                    tension: 0.3,
                    pointRadius: 4,
                    pointBackgroundColor: '#f5c542',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        labels: {
                            color: '#f5c542',
                            font: {
                                family: 'Cinzel',
                                size: 14
                            }
                        }
                    },
                    tooltip: {
                        backgroundColor: '#2e2e2e',
                        titleColor: '#f5c542',
                        bodyColor: '#f2c14e',
                        borderColor: '#f5c542',
                        borderWidth: 1,
                        callbacks: {
                            title: (items) => {
                                const index = items[0].dataIndex;
                                const rawDate = new Date(moodsData[index].date);
                                return rawDate.toLocaleString();
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            color: 'rgba(245, 197, 66, 0.1)'
                        },
                        ticks: {
                            color: '#f5c542',
                            maxRotation: 45,
                            minRotation: 45
                        }
                    },
                    y: {
                        min: 1,
                        max: 5,
                        grid: {
                            color: 'rgba(245, 197, 66, 0.1)'
                        },
                        ticks: {
                            color: '#f5c542',
                            stepSize: 1,
                            callback: function(value) {
                                return Number.isInteger(value) ? value : '';
                            }
                        }
                    }
                }
            }
        });
    });
</script>
<!-- Calendar Script -->
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const startDate = dayjs().subtract(1, 'month').startOf('month').toDate();

        // 1) Instantiate CalHeatmap
        const cal = new CalHeatmap();
        
        /*
            2) “Paint” the calendar, telling CalHeatmap
            - Where to get data (source)
            - That we want a domain of "year" type, subDomain as "day"
            - We can set range to 2 or 3 if we want multiple years visible
            - We can choose a purple color scale
        */
        cal.paint(
            {
                itemSelector: "#journal-calendar", // ID of the div
                range: 2, // 2 month displayed by default
                date: {
                    start: startDate
                },
                domain: {
                    type: "month",
                    padding: [10, 10, 10, 10],
                    label: { position: "top" }
                },
                subDomain: {
                    type: "xDay", 
                    radius: 2, 
                    width: 15, 
                    height: 15, 
                    label: "D" 
                },
                // The data is an object keyed by date. 
                data: {
                    source: "/data/api/calendar-entries",
                    type: "json",
                    x: d => d.timestamp * 1000,  // the property holding the timestamp (in seconds)
                    y: d => +d.value,    // the property holding the count
                },
                // Scale from 0 => 1 or 2. If your data is strictly “yes/no,” domain can be [0,1].
                scale: {
                    color: {
                        type: "sequential",
                        scheme: "Purples",  // Built-in D3 scheme, or 'PRGn' etc.
                        // domain covers data range, e.g. 0–3 or 0–10
                        domain: [0, 1],
                    },
                },
            },
        
        // 3) Add optional plugins, e.g. tooltip & legend
        [
            [
                Tooltip,
                {
                    text: (timestamp, value, dayjsDate) => 
                        (value ? `${value} entries` : "No entries") + 
                        " on " + 
                        dayjsDate.format("LL")
                }
            ]
        ]
    );
        
        // Navigation buttons for previous/next.
        document.getElementById("prev").addEventListener("click", function(e) {
            e.preventDefault();
            cal.previous();
        });
        document.getElementById("next").addEventListener("click", function(e) {
            e.preventDefault();
            cal.next();
        });
    });
</script>

