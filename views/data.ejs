<script>
    document.addEventListener("DOMContentLoaded", async () => {
        const ctx = document.getElementById('suitChart').getContext('2d');

        const suitsData = <%- JSON.stringify(suitsData) %>;

        const labels = suitsData.map(item => item.suit); // Suit names
        const counts = suitsData.map(item => item.count); // Suit counts

        // Create the Polar Area Chart
        // Define colors for the suits
        const colors = [
            'rgba(231, 76, 60, 0.8)',  // Major Arcana
            'rgba(52, 152, 219, 0.8)', // Pentacles
            'rgba(241, 196, 15, 0.8)', // Wands
            'rgba(46, 204, 113, 0.8)', // Cups
            'rgba(155, 89, 182, 0.8)'  // Swords
        ];

        // Define border colors for more contrast
        const borderColors = colors.map(color => color.replace('0.8', '1'));

        // Create the Polar Area Chart
        new Chart(ctx, {
            type: 'polarArea',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Card Suit Counts',
                    data: counts,
                    backgroundColor: colors,
                    borderColor: borderColors,
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                animation: {
                    animateScale: true, // Smooth scaling animation
                    animateRotate: true // Smooth rotation animation
                },
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: '#f5c542', // Matches your theme
                            font: {
                                family: 'Cinzel',
                                size: 16
                            },
                            boxWidth: 20
                        },
                    },
                    tooltip: {
                        enabled: true,
                        backgroundColor: '#2e2e2e',
                        titleColor: '#f5c542',
                        bodyColor: '#f2c14e',
                        bodyFont: {
                            family: 'Cinzel',
                            size: 14
                        },
                        padding: 12,
                        borderColor: '#f5c542',
                        borderWidth: 1,
                        callbacks: {
                            label: (tooltipItem) => {
                                const suit = labels[tooltipItem.dataIndex];
                                const count = counts[tooltipItem.dataIndex];
                                return `${suit}: ${count} draws`;
                            }
                        }
                    }
                },
                scales: {
                    r: {
                        grid: {
                            color: 'rgba(245, 197, 66, 0.2)',
                            circular: true
                        },
                        ticks: {
                            color: '#f5c542',
                            showLabelBackdrop: false,
                            stepSize: 5
                        }
                    }
                }
            }
        });

        // Add mood chart setup here
        const moodCtx = document.getElementById('moodChart').getContext('2d');
        const moodsData = <%- JSON.stringify(moodsData) %>;
        
        // Process mood data
        const dates = moodsData.map(entry => new Date(entry.created_at).toLocaleDateString());
        const moods = moodsData.map(entry => entry.mood);

        new Chart(moodCtx, {
            type: 'line',
            data: {
                labels: dates,
                datasets: [{
                    label: 'Mood Level',
                    data: moods,
                    borderColor: '#f5c542',
                    backgroundColor: 'rgba(245, 197, 66, 0.2)',
                    tension: 0.3,
                    pointRadius: 4,
                    pointBackgroundColor: '#f5c542',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        labels: {
                            color: '#f5c542',
                            font: {
                                family: 'Cinzel',
                                size: 14
                            }
                        }
                    },
                    tooltip: {
                        backgroundColor: '#2e2e2e',
                        titleColor: '#f5c542',
                        bodyColor: '#f2c14e',
                        borderColor: '#f5c542',
                        borderWidth: 1,
                        callbacks: {
                            title: (items) => {
                                const rawDate = new Date(moodsData[items[0].dataIndex].created_at);
                                return rawDate.toLocaleString();
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: {
                            color: 'rgba(245, 197, 66, 0.1)'
                        },
                        ticks: {
                            color: '#f5c542',
                            maxRotation: 45,
                            minRotation: 45
                        }
                    },
                    y: {
                        min: 1,
                        max: 5,
                        grid: {
                            color: 'rgba(245, 197, 66, 0.1)'
                        },
                        ticks: {
                            color: '#f5c542',
                            stepSize: 1,
                            callback: function(value) {
                                return Number.isInteger(value) ? value : '';
                            }
                        }
                    }
                }
            }
        });
    });
</script>

<style>
