    }


    

    /* Center and enhance the chart */
    #suitChart {
        display: block;
        margin: 20px auto;
        max-width: 70%;
        filter: drop-shadow(0 6px 15px rgba(0, 0, 0, 0.8));
    }

    /* Legend customization (if applicable) */
    .chart-legend {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        margin-top: 20px;
        padding-left: 20px;
    }

    .chart-legend span {
        display: inline-block;
        width: 25px;
        height: 25px;
        margin-right: 10px;
        border-radius: 50%;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.5);
    }

    .chart-wrapper {
        position: relative;
        margin: 0 auto;
        width: 90%;
        height: 400px;
    }

    #moodChart {
        width: 100% !important;
        height: 100% !important;
    }
</style>

