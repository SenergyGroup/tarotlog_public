<%- include('partials/header'); -%>

<script src="/profile.js"></script>

<body class="bg-gradient">
  <main class="dashboard">
    <!-- Sidebar with updated structure and modern classes -->
    <aside class="sidebar" id="sidebar-left" onclick="location.href='/data'">
      <h1 class="page-title">My Stats</h1>
      <div class="card">
        <ul>
          <h4>Current Streak</h4>
          <li><strong><%= dailyStreak %></strong> days</li>
          <h4>Total Responses</h4>
          <li><strong><%= totalResponses %></strong></li>
          <h4>Times Journaled (Month)</h4>
          <li><strong><%= monthResponses %></strong></li>
          <h4>Average Mood (Month)</h4>
          <li><strong><%= formattedAvgMood || 'No Data Yet' %></strong></li>
          <h4>Most Pulled Card</h4>
          <li><strong><%= mostPulledCard || 'No Data Yet' %></strong></li>
        </ul>
      </div>
    </aside>
  
    <!-- Main content updated to use modern card styles -->
    <section class="main-content">
      <!-- Previous Entry Card -->
      <div class="card" id="prevEntry" onclick="toggleEntry()">
        <h2>Previous Entry</h2>
        <p>Click to load your previous entry.</p>
      </div>
    
      <!-- Actions Card with updated button classes -->
      <div class="card">
        <h2>Actions</h2>
        <div class="action-buttons">
          <a href="/tarot" class="btn btn-primary">Draw a Card</a>
          <a href="/open-journal" class="btn btn-outline">Open Journal</a>
        </div>
      </div>
    </section>
  
    <!-- Extras using modern card styling -->
    <aside class="extras">
      <h1 class="page-title">Card of the Day</h1>
      <div class="card" onclick="location.href='/card-glossary?card_id=<%= dailyCard.card_id %>'">
        <% if (dailyCard) { %>
          <img src="<%= dailyCard.image_data %>" alt="<%= dailyCard.card_name %>" class="daily-card-image">
          <h4 class="card-name"><%= dailyCard.card_name %></h4>
          <p class="card-motto"><%= dailyCard.mottos %></p>
        <% } else { %>
          <p>No card available for today.</p>
        <% } %>
      </div>
    </aside>
  </main>
  <script>
    // Global variable to store the expanded HTML content
    let fullEntryHtml = null;
    
    function toggleEntry() {
      const prevEntryCard = document.getElementById('prevEntry');
      const dashboard = document.querySelector('.dashboard');
      const isExpanded = dashboard.classList.contains('expanded');
  
      if (isExpanded) {
        // Collapse: remove 'expanded' from .dashboard
        dashboard.classList.remove('expanded');
        // Reset the card content
        prevEntryCard.innerHTML = `
          <h2>Previous Entry</h2>
          <p>Click to load your previous entry.</p>
        `;
      } else {
        // Expand: add 'expanded' to .dashboard
        dashboard.classList.add('expanded');
        
        // If we already have the full entry stored, reuse it
        if (fullEntryHtml) {
          prevEntryCard.innerHTML = fullEntryHtml;
        } else {
          // Otherwise, fetch the entry data from the API
          fetch('/dashboard/latest-entry')
            .then(response => response.json())
            .then(data => {
              if (data.latestEntry) {
                fullEntryHtml = `
                  <h2>Previous Entry</h2>
                  <p class="last-entry"><strong>Prompt:</strong> ${data.latestEntry.prompt_text}</p><br>
                  <p class="last-entry"><strong>Response:</strong> ${data.latestEntry.response_text}</p><br>
                  <p><small><strong>Date:</strong> ${
                    new Date(data.latestEntry.created_at).toLocaleString()
                  }</small></p>
                `;
              } else {
                fullEntryHtml = '<h2>Previous Entry</h2><p>No previous entry found. Start your journal!</p>';
              }
              prevEntryCard.innerHTML = fullEntryHtml;
            })
            .catch(err => {
              console.error("Error fetching latest entry:", err);
              fullEntryHtml = '<h2>Previous Entry</h2><p>Error loading entry</p>';
              prevEntryCard.innerHTML = fullEntryHtml;
            });
        }
      }
      // Scroll the card into view smoothly
      prevEntryCard.scrollIntoView({ behavior: 'smooth' });
    }
  </script>
<%- include('partials/footer'); -%>
