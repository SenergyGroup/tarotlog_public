<%- include('partials/header'); -%>

<script src="/profile.js"></script>


<style>
    :root {
        --card-background: #2e2e2e;
        --accent-purple: #7a4b9f;
        --hover-purple: #5e3b7d;
    }
  /* Global Styles */
  body {
    margin: 0;
    font-family: 'Arial', sans-serif;
    background: var(--background-dark);
    color: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
  }
  .dashboard {
    width: 90%;
    max-width: 1200px;
    margin: 40px;
  }
  /* Header */
  .dashboard-header {
    text-align: center;
    margin-bottom: 30px;
  }
  .dashboard-header h1 {
    font-size: 2.5rem;
    margin: 0;
    font-family: 'Cinzel', serif;
  }
  /* Dashboard Content Grid */
  .dashboard-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    transition: all 0.3s ease;
  }
  /* Expanded State: Previous Entry spans full width; the other two are in a new row, side by side */
  .dashboard-content.expanded {
    grid-template-columns: 1fr 1fr;
  }
  .dashboard-content.expanded .previous-entry {
    grid-column: 1 / -1;
  }
  /* Card Styling */
  .card {
    background: var(--card-background);
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    cursor: pointer;
    transition: transform 0.2s ease;
  }
  .card:hover {
    transform: scale(1.02);
  }
  .card h2 {
    margin-bottom: 15px;
    font-family: 'Cinzel', serif;
  }
  .card.previous-entry p {
      text-align: left;
  }
  /* Actions Card - header stays on top, buttons are in their own container */
  .actions .action-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 10px;
  }
  /* Button Styles */
  .btn {
    background-color: var(--accent-purple);
    color: #fff;
    border: none;
    padding: 12px 24px;
    margin: 10px 5px;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    font-size: 1rem;
    text-decoration: none;
    display: inline-block;
  }
  .btn:hover {
    background-color: var(--hover-purple);
  }
  /* Responsive */
  @media (max-width: 768px) {
    .dashboard {
      margin: 20px;
    }
  }
</style>
</head>
<body>
  <div class="dashboard">
    <div class="dashboard-content" id="dashboardContent">
      <!-- Previous Entry Card -->
      <div class="card previous-entry" id="prevEntry" onclick="toggleEntry()">
          <h2>Previous Entry</h2>
          <p>Click to load your previous entry.</p>
      </div>          
      <!-- Streak Data Card -->
      <div class="card streak-data" onclick="location.href='/data'">
        <h2>Data</h2>
        <p>Current Streak: <strong><%= dailyStreak %></strong> days</p>
      </div>
      <!-- Actions Card -->
      <div class="card actions">
        <h2>Actions</h2>
        <div class="action-buttons">
          <a href="/tarot" class="btn draw-card">Draw a Card</a>
          <a href="/open-journal" class="btn open-journal">Open Journal</a>
        </div>
      </div>
    </div>
  </div>
  <script>
    // Global variable to store the expanded HTML content
    let fullEntryHtml = null;
    
    function toggleEntry() {
      const prevEntryCard = document.getElementById('prevEntry');
      const content = document.getElementById('dashboardContent');
      const isExpanded = content.classList.contains('expanded');
  
      if (isExpanded) {
        // Collapse the card: remove expanded class and set default text
        content.classList.remove('expanded');
        prevEntryCard.innerHTML = `
          <h2>Previous Entry</h2>
          <p>Click to load your previous entry.</p>
        `;
      } else {
        // Expand the card: add expanded class
        content.classList.add('expanded');
        
        // If we already have the full entry stored, reuse it
        if (fullEntryHtml) {
          prevEntryCard.innerHTML = fullEntryHtml;
        } else {
          // Otherwise, fetch the entry data from the API
          fetch('/dashboard/latest-entry')
            .then(response => response.json())
            .then(data => {
                if (data.latestEntry) {
                    fullEntryHtml = `
                      <h2>Previous Entry</h2>
                      <p><strong>Prompt:</strong> ${data.latestEntry.prompt_text}</p>
                      <br>
                      <p><strong>Response:</strong> ${data.latestEntry.response_text}</p>
                      <br>
                      <p><small><strong>Date:</strong> ${new Date(data.latestEntry.created_at).toLocaleString()}</small></p>
                    `;
                } else {
                    fullEntryHtml = '<h2>Previous Entry</h2><p>No previous entry found. Start your journal!</p>';
                }
                prevEntryCard.innerHTML = fullEntryHtml;
            })
            .catch(err => {
                console.error("Error fetching latest entry:", err);
                fullEntryHtml = '<h2>Previous Entry</h2><p>Error loading entry</p>';
                prevEntryCard.innerHTML = fullEntryHtml;
            });
        }
      }
      // Scroll the card into view smoothly
      prevEntryCard.scrollIntoView({ behavior: 'smooth' });
    }
  </script>
<%- include('partials/footer'); -%>
