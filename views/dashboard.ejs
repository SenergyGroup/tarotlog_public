<%- include('partials/header'); -%>

<script src="/profile.js"></script>


<style>
    :root {
        --card-background: #2e2e2e;
        --accent-purple: #7a4b9f;
        --hover-purple: #5e3b7d;
    }
  /* Global Styles */
  body {
    margin: 0;
    font-family: 'Arial', sans-serif;
    background: var(--background-dark);
    color: #fff;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
  }
  .dashboard {
    width: 95%;
    max-width: 1200px;
    margin: 40px;
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: 2rem;
    padding: 2rem;
  }
  .sidebar, .extras {
    background: rgba(0, 0, 0, 0.3);
    padding: 1.5rem;
    border-radius: 8px;
    cursor: pointer;
  }
  .sidebar#sidebar-left {
    cursor: pointer;
  }
  .sidebar#sidebar-left h2 {
  margin-bottom: 1rem;
  text-align: center;
}
  .sidebar#sidebar-left h4 {
    margin-bottom: 0.9rem;
    text-align: center;
    color: #f5c542;
  }

  /* Remove default bullets and spacing for the UL */
  .sidebar#sidebar-left ul {
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: center;
  }

  /* Spacing between list items */
  .sidebar#sidebar-left li {
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }
  .main-content > div {
    background: rgba(255, 255, 255, 0.1);
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    border-radius: 8px;
  }
  h2, h3 {
    margin-bottom: 1rem;
  }
  /* Card Styling */
  .card {
    background: var(--card-background);
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    
    transition: transform 0.2s ease;
  }
  .card:hover {
    transform: scale(1.02);
  }
  .card h2 {
    margin-bottom: 15px;
    font-family: 'Cinzel', serif;
  }
  .card.previous-entry {
      cursor: pointer;
  }
  .card.previous-entry p {
      text-align: left;
  }
  /* Actions Card - header stays on top, buttons are in their own container */
  .actions .action-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 10px;
  }
  /* Button Styles */
  .btn {
    background-color: var(--accent-purple);
    color: #fff;
    border: none;
    padding: 12px 24px;
    margin: 10px 5px;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.3s ease;
    font-size: 1rem;
    text-decoration: none;
    display: inline-block;
  }
  .btn:hover {
    background-color: var(--hover-purple);
  }
  .card-of-day {
    background-color: #2e2e2e;
    padding: 20px;
    border-radius: 8px;
    text-align: center;
    box-shadow: 0 4px 8px rgba(0,0,0,0.3);
    margin-top: 20px;
  }

  .daily-card-image {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    margin-bottom: 10px;
  }

  .card-name {
    font-size: 1.5rem;
    margin: 10px 0 5px;
    color: #f5c542;
  }

  .card-motto {
    font-size: 1.1rem;
    color: #e0e0e0;
    margin: 0;
  }
  /* Responsive */
  @media (max-width: 1024px) {
    .dashboard {
      grid-template-columns: 1fr;
    }
  
    .sidebar, .extras {
      order: 1;
      margin-top: 1rem;
    }
  
    .main-content {
      order: 2;
    }
    @media (max-width: 768px) {
      .dashboard {
      padding: 1rem;
    }
  
    .sidebar, .extras, .main-content > div {
      padding: 1rem;
    }
  }
  }
</style>
</head>
<body>
  <main class="dashboard">
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar-left" onclick="location.href='/data'">
      <h1>My Stats</h1>
      <div class="card-of-day">
        <ul>
          <h4>Current Streak</h3>
          <li><strong><%= dailyStreak %></strong> days</li>
          <h4>Total Responses</h3>
          <li><strong><%= totalResponses %></strong></li>
          <h4>Times Journaled (Month)</h3>
          <li><strong><%= monthResponses %></strong></li>
          <h4>Average Mood (Month)</h3>
          <li><strong><%= formattedAvgMood || 'No Data Yet' %></strong></li>
          <h4>Most Pulled Card</h3>
          <li><strong><%= mostPulledCard || 'No Data Yet' %></strong></li>
        </ul>
      </div>
    </aside>
  
    <!-- Main content -->
    <section class="main-content">
      <!-- Previous Entry Card -->
      <div class="card previous-entry" id="prevEntry" onclick="toggleEntry()">
        <h1>Previous Entry</h2>
        <p>Click to load your previous entry.</p>
      </div>
    
      <!-- Actions Card -->
      <div class="card actions">
        <h1>Actions</h2>
        <div class="action-buttons">
          <a href="/tarot" class="btn draw-card">Draw a Card</a>
          <a href="/open-journal" class="btn open-journal">Open Journal</a>
        </div>
      </div>
    </section>
  
    <!-- Extras (optional) -->
    <aside class="extras">
      <h1>Card of the Day</h1>
      <div class="card-of-day" 
      onclick="location.href='/card-glossary?card_id=<%= dailyCard.card_id %>'">
        <% if (dailyCard) { %>
          <img src="<%= dailyCard.image_data %>" alt="<%= dailyCard.card_name %>" class="daily-card-image">
          <h4 class="card-name"><%= dailyCard.card_name %></h4>
          <p class="card-motto"><%= dailyCard.mottos %></p>
        <% } else { %>
          <p>No card available for today.</p>
        <% } %>
      </div>
    </div>
    </aside>
  </main>
  <script>
    // Global variable to store the expanded HTML content
    let fullEntryHtml = null;
    
    function toggleEntry() {
      const prevEntryCard = document.getElementById('prevEntry');
      const dashboard = document.querySelector('.dashboard');
      const isExpanded = dashboard.classList.contains('expanded');
  
      if (isExpanded) {
        // Collapse: remove 'expanded' from .dashboard
        dashboard.classList.remove('expanded');
        // Reset the card content
        prevEntryCard.innerHTML = `
          <h2>Previous Entry</h2>
          <p>Click to load your previous entry.</p>
        `;
      } else {
        // Expand: add 'expanded' to .dashboard
        dashboard.classList.add('expanded');
        
        // If we already have the full entry stored, reuse it
        if (fullEntryHtml) {
          prevEntryCard.innerHTML = fullEntryHtml;
        } else {
          // Otherwise, fetch the entry data from the API
          fetch('/dashboard/latest-entry')
            .then(response => response.json())
            .then(data => {
              if (data.latestEntry) {
                fullEntryHtml = `
                  <h2>Previous Entry</h2>
                  <p><strong>Prompt:</strong> ${data.latestEntry.prompt_text}</p><br>
                  <p><strong>Response:</strong> ${data.latestEntry.response_text}</p><br>
                  <p><small><strong>Date:</strong> ${
                    new Date(data.latestEntry.created_at).toLocaleString()
                  }</small></p>
                `;
              } else {
                fullEntryHtml = '<h2>Previous Entry</h2><p>No previous entry found. Start your journal!</p>';
              }
              prevEntryCard.innerHTML = fullEntryHtml;
            })
            .catch(err => {
              console.error("Error fetching latest entry:", err);
              fullEntryHtml = '<h2>Previous Entry</h2><p>Error loading entry</p>';
              prevEntryCard.innerHTML = fullEntryHtml;
            });
        }
      }
      // Scroll the card into view smoothly
      prevEntryCard.scrollIntoView({ behavior: 'smooth' });
    }
  </script>
<%- include('partials/footer'); -%>
