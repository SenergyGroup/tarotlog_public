<%- include('partials/header'); -%>
<script src="/profile.js"></script>
<style>
  img {
    width: 100%;
  }
</style>

<div class="settings-container">
  <nav class="settings-nav">
    <ul>
      <li data-section="all" class="active">All Cards</li>
      <li data-section="major">Major Arcana</li>
      <li data-section="wands">Wands</li>
      <li data-section="cups">Cups</li>
      <li data-section="swords">Swords</li>
      <li data-section="pentacles">Pentacles</li>
      <li data-section="top">Top Cards</li>
    </ul>
  </nav>

  <div class="settings-content">
    <!-- ALL CARDS SECTION -->
    <div class="settings-section active" id="all">
      <h2>All Cards</h2>
      <div class="card-grid">
        <% if (cards && cards.length > 0) { %>
          <% cards.forEach(card => { %>
            <div class="card-individual"
                 data-card-id="<%= card.card_id %>"
                 data-image="<%= card.image_url %>"
                 data-name="<%= card.card_name %>"
                 data-upright="<%= card.description_upright %>"
                 data-reversed="<%= card.description_reversed %>"
                 onclick="openModal('<%= card.card_id %>')">
              <div class="card-content">
                <img src="<%= card.image_url %>" alt="<%= card.card_name %>">
                <h3><%= card.card_name %></h3>
              </div>
              <div class="card-footer">
                <p>Total entries: <%= card.total_entries %></p>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <p>No cards found.</p>
        <% } %>
      </div>
    </div>

    <!-- MAJOR ARCANA SECTION -->
    <div id="major" class="settings-section">
      <h2>Major Arcana</h2>
      <div class="card-grid">
        <% cards.forEach(card => { %>
          <% if (card.suit === 'Major Arcana') { %>
            <div class="card" onclick="openModal('<%= card.card_id %>')">
              <div class="card-content">
                <img src="<%= card.image_url %>" alt="<%= card.card_name %>">
                <h3><%= card.card_name %></h3>
              </div>
              <div class="card-footer">
                <p>Total entries: <%= card.total_entries %></p>
              </div>
            </div>
          <% } %>
        <% }); %>
      </div>
    </div>

    <!-- WANDS SECTION -->
    <div id="wands" class="settings-section">
      <h2>Wands</h2>
      <div class="card-grid">
        <% cards.forEach(card => { %>
          <% if (card.suit === 'Wands') { %>
            <div class="card" onclick="openModal('<%= card.card_id %>')">
              <div class="card-content">
                <img src="<%= card.image_url %>" alt="<%= card.card_name %>">
                <h3><%= card.card_name %></h3>
              </div>
              <div class="card-footer">
                <p>Total entries: <%= card.total_entries %></p>
              </div>
            </div>
          <% } %>
        <% }); %>
      </div>
    </div>

    <!-- CUPS SECTION -->
    <div id="cups" class="settings-section">
      <h2>Cups</h2>
      <div class="card-grid">
        <% cards.forEach(card => { %>
          <% if (card.suit === 'Cups') { %>
            <div class="card" onclick="openModal('<%= card.card_id %>')">
              <div class="card-content">
                <img src="<%= card.image_url %>" alt="<%= card.card_name %>">
                <h3><%= card.card_name %></h3>
              </div>
              <div class="card-footer">
                <p>Total entries: <%= card.total_entries %></p>
              </div>
            </div>
          <% } %>
        <% }); %>
      </div>
    </div>

    <!-- SWORDS SECTION -->
    <div id="swords" class="settings-section">
      <h2>Swords</h2>
      <div class="card-grid">
        <% cards.forEach(card => { %>
          <% if (card.suit === 'Swords') { %>
            <div class="card" onclick="openModal('<%= card.card_id %>')">
              <div class="card-content">
                <img src="<%= card.image_url %>" alt="<%= card.card_name %>">
                <h3><%= card.card_name %></h3>
              </div>
              <div class="card-footer">
                <p>Total entries: <%= card.total_entries %></p>
              </div>
            </div>
          <% } %>
        <% }); %>
      </div>
    </div>

    <!-- PENTACLES SECTION -->
    <div id="pentacles" class="settings-section">
      <h2>Pentacles</h2>
      <div class="card-grid">
        <% cards.forEach(card => { %>
          <% if (card.suit === 'Pentacles') { %>
            <div class="card" onclick="openModal('<%= card.card_id %>')">
              <div class="card-content">
                <img src="<%= card.image_url %>" alt="<%= card.card_name %>">
                <h3><%= card.card_name %></h3>
              </div>
              <div class="card-footer">
                <p>Total entries: <%= card.total_entries %></p>
              </div>
            </div>
          <% } %>
        <% }); %>
      </div>
    </div>

    <!-- TOP CARDS SECTION -->
    <div id="top" class="settings-section">
      <h2>Top Cards</h2>
      <div class="card-grid" id="topCardsContainer">
        <!-- Top cards will be dynamically loaded here via loadTopCards() -->
      </div>
    </div>
  </div>
</div>

<!-- Modal for Card Descriptions -->
<div id="cardModal" class="modal">
  <div class="modal-content">
    <span class="close-btn" onclick="closeModal()">&times;</span>
    <div id="modal-text"></div>
  </div>
</div>

<script src="/cards.js"></script>
<%- include('partials/footer'); -%>
