<%- include('partials/header'); -%>
<script src="/profile.js"></script>

<style>
/* 1) Card Grid for Glossary */
.card-grid {
  display: grid;
  /* Each card is at least 120px wide, and the grid fills the remaining space */
  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  gap: 1rem;
  margin-top: 1rem;
}

/* 2) Individual Cards */
.card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 120px; /* or adjust as you like */
  min-height: 280px; 
  margin: 0.25rem;
  background-color: #444;
  border-radius: 8px;
  padding: 0.5rem;
  text-align: center;
  color: #fff;
  cursor: pointer;
  transition: background-color 0.3s ease, transform 0.2s;
}

.card:hover {
  background-color: #584ce0;
  transform: scale(1.01);
}

.card-content {
  flex-grow: 1; /* push footer to the bottom */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.card-content img {
  width: 100%;
  height: auto;
  border-radius: 4px;
  margin-bottom: 0.5rem;
}

.card-footer {
  margin-top: auto;
}

.card-footer p {
  margin: 0.5rem 0 0 0;
  color: #f2c14e; /* accent color for “Total entries” */
}

/* Modal styling, etc. (unchanged) */
.modal {
  display: none;
  position: fixed;
  z-index: 9999;
  left: 0; 
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.8);
  justify-content: center;
  align-items: center;
}

.modal.show {
  animation: fadeIn 0.3s ease forwards;
}

.modal-content {
  position: relative;
  background: linear-gradient(145deg, #1f1f1f, #2b2b2b);
  border: 1px solid #444;
  border-radius: 8px;
  width: 90%;
  max-width: 600px;
  margin: auto;
  padding: 2rem;
  box-shadow: 0 0 15px rgba(0, 0, 0, 0.5);
  text-align: left;
  color: #f5f5f5;
  font-family: 'Cinzel', serif;
}

.close-btn {
  position: absolute;
  top: 1rem;
  right: 1rem;
  font-size: 1.5rem;
  cursor: pointer;
  background: transparent;
  border: none;
  outline: none;
  color: #fff;
  transition: color 0.3s ease;
}

.close-btn:hover {
  color: #f2c14e;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* Additional modal text styles */
.modal-content p {
  margin-bottom: 1rem;
  line-height: 1.6;
}

.modal-content p strong {
  color: #f2c14e;
  font-weight: bold;
}

.modal-content h4 {
  margin-top: 1.5rem;
  padding-top: 1rem;
  border-top: 1px solid #555;
  color: #f2c14e;
  text-transform: uppercase;
  text-align: center;
}

/* Entry counts container in the modal */
.entry-counts {
  display: flex;
  justify-content: space-between;
  margin-top: 1rem;
  padding: 0 1rem;
}

.upright-count {
  color: #f2c14e;
  font-weight: bold;
}
.reversed-count {
  color: #7a4b9f;
  font-weight: bold;
}
</style>

<div class="settings-container">
  <nav class="settings-nav">
    <ul>
      <li data-section="all" class="active">All Cards</li>
      <li data-section="major">Major Arcana</li>
      <li data-section="wands">Wands</li>
      <li data-section="cups">Cups</li>
      <li data-section="swords">Swords</li>
      <li data-section="pentacles">Pentacles</li>
      <li data-section="top">Top Cards</li>
    </ul>
  </nav>

  <div class="settings-content">
    <!-- ALL CARDS SECTION -->
    <div class="settings-section active" id="all">
      <h2>All Cards</h2>
      <div class="card-grid">
        <% if (cards && cards.length > 0) { %>
          <% cards.forEach(card => { %>
            <div class="card"
                 data-card-id="<%= card.card_id %>"
                 data-name="<%= card.card_name %>"
                 data-upright="<%= card.description_upright %>"
                 data-reversed="<%= card.description_reversed %>"
                 onclick="openModal('<%= card.card_id %>')">
              <div class="card-content">
                <img src="<%= card.image_url %>" alt="<%= card.card_name %>">
                <h3><%= card.card_name %></h3>
              </div>
              <div class="card-footer">
                <p>Total entries: <%= card.total_entries %></p>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <p>No cards found.</p>
        <% } %>
      </div>
    </div>

    <!-- MAJOR ARCANA SECTION -->
    <div id="major" class="settings-section">
      <h2>Major Arcana</h2>
      <div class="card-grid">
        <% cards.forEach(card => { %>
          <% if (card.suit === 'Major Arcana') { %>
            <div class="card" onclick="openModal('<%= card.card_id %>')">
              <div class="card-content">
                <img src="<%= card.image_url %>" alt="<%= card.card_name %>">
                <h3><%= card.card_name %></h3>
              </div>
              <div class="card-footer">
                <p>Total entries: <%= card.total_entries %></p>
              </div>
            </div>
          <% } %>
        <% }); %>
      </div>
    </div>

    <!-- WANDS SECTION -->
    <div id="wands" class="settings-section">
      <h2>Wands</h2>
      <div class="card-grid">
        <% cards.forEach(card => { %>
          <% if (card.suit === 'Wands') { %>
            <div class="card" onclick="openModal('<%= card.card_id %>')">
              <div class="card-content">
                <img src="<%= card.image_url %>" alt="<%= card.card_name %>">
                <h3><%= card.card_name %></h3>
              </div>
              <div class="card-footer">
                <p>Total entries: <%= card.total_entries %></p>
              </div>
            </div>
          <% } %>
        <% }); %>
      </div>
    </div>

    <!-- CUPS SECTION -->
    <div id="cups" class="settings-section">
      <h2>Cups</h2>
      <div class="card-grid">
        <% cards.forEach(card => { %>
          <% if (card.suit === 'Cups') { %>
            <div class="card" onclick="openModal('<%= card.card_id %>')">
              <div class="card-content">
                <img src="<%= card.image_url %>" alt="<%= card.card_name %>">
                <h3><%= card.card_name %></h3>
              </div>
              <div class="card-footer">
                <p>Total entries: <%= card.total_entries %></p>
              </div>
            </div>
          <% } %>
        <% }); %>
      </div>
    </div>

    <!-- SWORDS SECTION -->
    <div id="swords" class="settings-section">
      <h2>Swords</h2>
      <div class="card-grid">
        <% cards.forEach(card => { %>
          <% if (card.suit === 'Swords') { %>
            <div class="card" onclick="openModal('<%= card.card_id %>')">
              <div class="card-content">
                <img src="<%= card.image_url %>" alt="<%= card.card_name %>">
                <h3><%= card.card_name %></h3>
              </div>
              <div class="card-footer">
                <p>Total entries: <%= card.total_entries %></p>
              </div>
            </div>
          <% } %>
        <% }); %>
      </div>
    </div>

    <!-- PENTACLES SECTION -->
    <div id="pentacles" class="settings-section">
      <h2>Pentacles</h2>
      <div class="card-grid">
        <% cards.forEach(card => { %>
          <% if (card.suit === 'Pentacles') { %>
            <div class="card" onclick="openModal('<%= card.card_id %>')">
              <div class="card-content">
                <img src="<%= card.image_url %>" alt="<%= card.card_name %>">
                <h3><%= card.card_name %></h3>
              </div>
              <div class="card-footer">
                <p>Total entries: <%= card.total_entries %></p>
              </div>
            </div>
          <% } %>
        <% }); %>
      </div>
    </div>

    <!-- TOP CARDS SECTION -->
    <div id="top" class="settings-section">
      <h2>Top Cards</h2>
      <div class="card-grid" id="topCardsContainer">
        <!-- Top cards will be dynamically loaded here via loadTopCards() -->
      </div>
    </div>
  </div>
</div>

<!-- Modal for Card Descriptions -->
<div id="cardModal" class="modal">
  <div class="modal-content">
    <span class="close-btn" onclick="closeModal()">&times;</span>
    <div id="modal-text"></div>
  </div>
</div>

<script src="/cards.js"></script>
<%- include('partials/footer'); -%>
