<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>MyTarotTales</title>

  <!-- Main site stylesheet (if you have an external one, keep this link) -->
  <link rel="stylesheet" href="/styles.css"> 

  <!-- Include a decorative serif font (for headings & buttons) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link 
    href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&display=swap" 
    rel="stylesheet"
  >

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-JYXX0G315R"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-JYXX0G315R');
  </script>
  <script src="/profile.js"></script>
<style>
    .hero-swirls {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      background:
        linear-gradient(to right, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.95) 100%),
        url('https://raw.githubusercontent.com/SenergyGroup/tarotlog_assets/refs/heads/main/swirl-bg.jpg')
          center center / cover no-repeat;
     z-index: -1;
    }
    .btn {
      font-size: 1rem;
      padding: 0.8rem 1.5rem;
      border-radius: 50px;
      border: 2px solid #fff;
      background: transparent;
      color: #fff;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .btn:hover {
      background: #fff;
      color: #000;
      transform: translateY(-2px);
    }
    /* Top Nav */
    .top-nav {
      position: absolute;
      top: 1rem;
      right: 1.5rem;
      z-index: 10;
      display: flex;
      align-items: center;
    }
    .desktop-nav ul {
      display: flex;
      gap: 1rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .desktop-nav a {
      display: inline-block;
      font-family: 'Cinzel Decorative', serif;
      font-weight: 400;
      font-size: 0.9rem;
      padding: 0.5rem 1.2rem;
      border-radius: 50px;
      border: 2px solid #fff;
      background: transparent;
      color: #fff;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    .desktop-nav a:hover {
      background: #fff;
      color: #000;
    }
    /* Hamburger menu for mobile */
    .hamburger {
      position: absolute; /* Moves it to the top right corner */
      top: 1rem;
      right: 1rem;
      background: none;
      border: none;
      font-size: 2rem;
      color: #fff;
      cursor: pointer;
      display: none; /* hidden on large screens */
      z-index: 11;
    }
    .mobile-menu {
      display: none;
      position: absolute;
      top: 3rem;
      right: 1rem;
      background: #fff;
      border: 2px solid #fff;
      border-radius: 5px;
      flex-direction: column;
      z-index: 10;
    }
    .mobile-menu a {
      display: block;
      padding: 0.5rem 1rem;
      color: #000;
      text-decoration: none;
    }
    .mobile-menu a:hover {
      background: #f0f0f0;
    }
    
    .hidden {
      display: none !important;
    }
    @media (max-width: 1099px) {
      .desktop-nav {
        display: none;
      }
      .hamburger {
        display: block;
      }
    }
    @media (max-width: 768px) {
      .desktop-nav {
        display: none;
      }
      .hero-text h1 {
      font-size: 3rem;
      margin-top: 9rem;
      }
    }
</style>
<header>
    <h1 class="brand-title">
        <% if (user) { %>
        <a href="/dashboard">MyTarotTales</a>
        <% } else { %>
        <a href="/">MyTarotTales</a>
        <% } %>
    </h1>
</header>
<div class="hero-swirls"></div>
<form action="/auth/signup" method="POST">
    <h1>Sign up</h1>
    <label for="username">Username</label>
    <input type="text" name="username" required />
    <div class="username error"></div>

    <label for="email">Email</label>
    <input type="text" name="email" required />
    <div class="email error"></div>

    <label for="password">Password</label>
    <input type="password" name="password" required />
    <div class="password error"></div>

    <button class="btn" type="submit">Sign up</button>
    <br><br>
    <div class="social-login">
        <a href="/auth/google" class="btn-google">
            <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 0 24 24" width="24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/><path d="M1 1h22v22H1z" fill="none"/></svg>
            <span>Continue with Google</span>
        </a>
    </div>
</form>

<!-- Success alert -->
<div class="overlay" id="overlay"></div>
<div class="alert-success" id="success-alert">
    Account created successfully!
</div>
<!-- Toggle script for mobile hamburger menu -->
<script>
    function toggleMenu() {
      var menu = document.getElementById('mobileMenu');
      menu.style.display = (menu.style.display === 'block') ? 'none' : 'block';
    }
  </script>

<script>
    const form = document.querySelector('form');
    const usernameError = document.querySelector('.username.error');
    const emailError = document.querySelector('.email.error');
    const passwordError = document.querySelector('.password.error');

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // reset errors
        usernameError.textContent = '';
        emailError.textContent = '';
        passwordError.textContent = '';

        //get the values
        const username = form.username.value;
        const email = form.email.value;
        const password = form.password.value;

        try {
            const res = await fetch('/auth/signup', {
                method: 'POST',
                body: JSON.stringify({ username: username, email: email, password: password}),
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.errors) {
                usernameError.textContent = data.errors.username || '';
                emailError.textContent = data.errors.email || '';
                passwordError.textContent = data.errors.password || '';
            }
            if (data.user) {
                const successAlert = document.getElementById("success-alert");
                const overlay = document.getElementById("overlay");

                successAlert.classList.add("show"); // Show the alert
                overlay.classList.add("show");

                setTimeout(() => {
                    successAlert.classList.remove("show");
                    overlay.classList.remove("show");
                    location.assign('/dashboard');
                }, 3000);
                
            }
        }
        catch (err) {
            console.log(err)
        }
    })
</script>
</body>
</html>